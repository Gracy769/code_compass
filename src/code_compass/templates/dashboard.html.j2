<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Code Compass — {{ repo_name }}</title>
  <style>
    /* ============================================================
       CODE COMPASS — ADVANCED GLASS/CLAY ARCHITECTURE DESIGN SYSTEM
       ============================================================ */

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* ── Primary palette ───────────────────────────────────────── */
      --bg-primary:     #070b14;
      --accent-cyan:    #00b4d8;
      --accent-blue:    #3b82d4;
      --glow-cyan:      rgba(0, 180, 216, 0.22);
      --glow-blue:      rgba(59, 130, 212, 0.28);

      /* ── Glass / blur tokens ───────────────────────────────────── */
      --glass-bg:       rgba(255, 255, 255, 0.04);
      --glass-bg-nav:   rgba(7, 11, 20, 0.92);
      --glass-border:   rgba(255, 255, 255, 0.10);
      --blur-radius:    16px;

      /* ── Shadow system ─────────────────────────────────────────── */
      --clay-shadow:
        0 1px 0 0 rgba(255,255,255,0.14) inset,
        0 -1px 0 0 rgba(0,0,0,0.35) inset,
        0 8px 24px -4px rgba(0,0,0,0.65),
        0 2px 6px -1px rgba(0,0,0,0.45);
      --clay-highlight:
        0 1px 0 0 rgba(255,255,255,0.18) inset,
        0 -1px 0 0 rgba(0,0,0,0.40) inset,
        0 12px 32px -4px rgba(0,180,216,0.25),
        0 4px 10px -2px rgba(0,0,0,0.55);
      --clay-press:
        0 1px 0 0 rgba(255,255,255,0.08) inset,
        0 2px 0 0 rgba(0,0,0,0.45) inset,
        0 2px 6px -1px rgba(0,0,0,0.55);

      /* ── Semantic tokens ───────────────────────────────────────── */
      --accent:         #3b82d4;
      --accent-hover:   #38bdf8;
      --accent-muted:   rgba(0, 180, 216, 0.20);
      --text-primary:   #e2e8f0;
      --text-secondary: #94a3b8;
      --surface:        rgba(255, 255, 255, 0.03);
      --danger:         #f87171;
      --warn:           #fbbf24;
      --success:        #86efac;
      --purple:         #c084fc;

      --radius-card:    1.25rem;
      --radius-btn:     1.2rem;
      --radius-sm:      0.5rem;
    }

    body {
      background-color: var(--bg-primary);
      background-image:
        radial-gradient(ellipse 100% 55% at 50% -5%,  rgba(0, 180, 216, 0.14), transparent),
        radial-gradient(ellipse  60% 45% at 90%  95%, rgba(139,  92, 246, 0.09), transparent),
        radial-gradient(ellipse  40% 30% at  0% 100%, rgba(59, 130, 212, 0.07), transparent),
        linear-gradient(180deg, #070b14 0%, #050810 100%);
      background-attachment: fixed;
      color: var(--text-primary);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
    }

    /* ── Sidebar ────────────────────────────────────────────────── */
    .sidebar {
      position: fixed;
      top: 0; left: 0;
      height: 100vh;
      width: 220px;
      background: rgba(7, 11, 20, 0.97);
      border-right: 1px solid rgba(0, 180, 216, 0.12);
      display: flex;
      flex-direction: column;
      z-index: 200;
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    .sidebar.collapsed { width: 64px; }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.1rem 1rem 1.1rem 1.1rem;
      border-bottom: 1px solid rgba(0, 180, 216, 0.10);
      min-height: 60px;
      flex-shrink: 0;
    }
    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      overflow: hidden;
      flex: 1;
    }
    .sidebar-logo-icon {
      width: 32px; height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, #0ea5e9, #3b82d4);
      box-shadow: 0 0 12px rgba(0,180,216,0.5), 0 2px 8px rgba(0,0,0,0.4);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .sidebar-brand-text {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      opacity: 1;
      transition: opacity 0.18s ease, width 0.25s ease;
      line-height: 1.2;
    }
    .sidebar.collapsed .sidebar-brand-text { opacity: 0; width: 0; }

    .sidebar-toggle {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 9px;
      color: var(--text-secondary);
      cursor: pointer;
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      padding: 0;
      flex-shrink: 0;
      transition: all 0.15s ease;
    }
    .sidebar-toggle:hover { background: rgba(0,180,216,0.15); color: #00b4d8; border-color: rgba(0,180,216,0.3); }
    .sidebar-toggle svg { width: 18px; height: 18px; transition: transform 0.25s ease; }
    .sidebar.collapsed .sidebar-toggle svg { transform: rotate(180deg); }

    .sidebar-nav {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 0.75rem 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .sidebar-nav::-webkit-scrollbar { width: 3px; }
    .sidebar-nav::-webkit-scrollbar-thumb { background: rgba(0,180,216,0.25); border-radius: 3px; }

    .sidebar-nav-btn {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem 0.75rem;
      border-radius: 9px;
      border: 1px solid transparent;
      background: none;
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      width: 100%;
      text-align: left;
      transition: all 0.15s ease;
      position: relative;
    }
    .sidebar-nav-btn:hover {
      background: rgba(0, 180, 216, 0.08);
      color: var(--text-primary);
      border-color: rgba(0,180,216,0.15);
    }
    .sidebar-nav-btn.active {
      background: rgba(0, 180, 216, 0.12);
      color: #38bdf8;
      border-color: rgba(0, 180, 216, 0.25);
      box-shadow: inset 3px 0 0 #00b4d8, 0 0 12px rgba(0,180,216,0.12);
      font-weight: 600;
    }
    .sidebar-nav-icon {
      width: 18px; height: 18px;
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .sidebar-nav-label {
      overflow: hidden;
      opacity: 1;
      transition: opacity 0.18s ease;
      flex: 1;
    }
    .sidebar.collapsed .sidebar-nav-label { opacity: 0; }
    /* Tooltip for collapsed state */
    .sidebar.collapsed .sidebar-nav-btn[data-tooltip]:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      left: 68px;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(7, 11, 20, 0.97);
      border: 1px solid rgba(0,180,216,0.3);
      color: #e2e8f0;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.35rem 0.7rem;
      border-radius: 7px;
      white-space: nowrap;
      pointer-events: none;
      z-index: 9999;
      box-shadow: 0 4px 14px rgba(0,0,0,0.5);
    }

    .sidebar-footer {
      padding: 0.75rem 0.5rem 1rem;
      border-top: 1px solid rgba(0,180,216,0.10);
      flex-shrink: 0;
    }
    .sidebar-footer-btn {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.6rem 0.75rem;
      border-radius: 9px;
      background: rgba(0,180,216,0.06);
      border: 1px solid rgba(0,180,216,0.15);
      color: #38bdf8;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      width: 100%;
      text-align: left;
      transition: all 0.15s ease;
    }
    .sidebar-footer-btn:hover { background: rgba(0,180,216,0.14); border-color: rgba(0,180,216,0.35); }
    .sidebar-footer-label {
      overflow: hidden;
      opacity: 1;
      transition: opacity 0.18s ease;
    }
    .sidebar.collapsed .sidebar-footer-label { opacity: 0; }

    /* ── Main Layout Wrapper ─────────────────────────────────────── */
    #main-layout {
      margin-left: 220px;
      min-height: 100vh;
      transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #main-layout.sidebar-collapsed { margin-left: 64px; }

    /* ── Nav Bar ────────────────────────────────────────────────── */
    .nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.7rem 1.75rem;
      background: rgba(7, 11, 20, 0.95);
      border-bottom: 1px solid rgba(0, 180, 216, 0.12);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nav-left { display: flex; align-items: center; gap: 0.85rem; }
    .nav-bar .app-name {
      font-weight: 800;
      font-size: 0.82rem;
      color: #ffffff;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    .nav-bar .repo-badge {
      font-size: 0.75rem;
      padding: 0.18rem 0.6rem;
      border-radius: 20px;
      background: rgba(0, 180, 216, 0.10);
      border: 1px solid rgba(0, 180, 216, 0.25);
      color: #67e8f9;
      font-weight: 500;
      max-width: 320px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .nav-actions { display: flex; align-items: center; gap: 1rem; }
    .nav-link {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .nav-link:hover { color: #38bdf8; }
    .new-analysis-link {
      display: inline-flex; align-items: center; gap: 0.45rem;
      padding: 0.42rem 0.75rem;
      border: 1px solid rgba(56,189,248,0.38);
      border-radius: 9px;
      background: rgba(14,165,233,0.10);
      color: #d8f4ff;
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: 700;
      white-space: nowrap;
      transition: background 0.18s ease, transform 0.18s ease;
    }
    .new-analysis-link:hover { background: rgba(14,165,233,0.22); transform: translateY(-1px); }
    .new-analysis-link[hidden] { display: none; }
    .new-analysis-link:focus-visible, .sidebar-toggle:focus-visible { outline: 2px solid #38bdf8; outline-offset: 2px; }
    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.95rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.06);
      color: var(--text-primary);
      transition: all 0.18s ease;
      box-shadow: var(--clay-shadow);
    }
    .action-btn:hover {
      background: rgba(255,255,255,0.12);
      border-color: rgba(255,255,255,0.25);
      transform: translateY(-1px);
    }
    .action-btn-primary {
      background: linear-gradient(135deg, #0ea5e9, #3b82d4);
      border-color: rgba(0,180,216,0.4);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(0,180,216,0.30);
    }
    .action-btn-primary:hover {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      box-shadow: 0 6px 18px rgba(0,180,216,0.40);
    }

    /* ── Content Area ───────────────────────────────────────────── */
    .tab-content { padding: 1.75rem; max-width: 1600px; margin: 0 auto; }
    .tab-section { display: none; }
    .tab-section.active { display: block; animation: fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    /* ── Bento Grid & Section Cards ─────────────────────────────── */
    .section-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-card);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(var(--blur-radius));
      box-shadow: var(--clay-shadow);
      overflow-x: auto;
    }
    .data-table {
      table-layout: fixed;
      width: 100%;
    }
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1.25rem;
      margin-bottom: 1.75rem;
    }
    .bento-col-4  { grid-column: span 4; }
    .bento-col-6  { grid-column: span 6; }
    .bento-col-8  { grid-column: span 8; }
    .bento-col-12 { grid-column: span 12; }
    @media (max-width: 1024px) {
      .bento-col-4, .bento-col-6, .bento-col-8 { grid-column: span 12; }
    }

    /* Stat Cards */
    .stat-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 1.1rem;
      margin-bottom: 1.75rem;
    }
    .stat-card {
      background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 1rem;
      padding: 1.2rem 1.4rem;
      box-shadow: var(--clay-shadow);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--clay-highlight);
    }
    .stat-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      margin-bottom: 0.35rem;
    }
    .stat-value {
      font-size: 1.95rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.15;
    }
    .stat-sub {
      font-size: 0.75rem;
      color: var(--text-secondary);
      margin-top: 0.35rem;
    }

    /* Health Gauge */
    .health-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 76px; height: 76px;
      border-radius: 50%;
      background: conic-gradient(#10b981 0% 92%, #374151 92% 100%);
      position: relative;
    }
    .health-inner {
      width: 60px; height: 60px;
      border-radius: 50%;
      background: #0f172a;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-size: 1.25rem; font-weight: 800; color: #10b981;
    }

    /* Tag Cloud */
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.6rem; }
    .tag-pill {
      font-size: 0.72rem;
      padding: 0.2rem 0.55rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .tag-pill:hover, .tag-pill.active {
      background: rgba(59, 130, 212, 0.22);
      border-color: rgba(59, 130, 212, 0.45);
      color: #93c5fd;
    }

    /* Tables & Toolbars */
    .table-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 1.25rem;
    }
    .table-toolbar input[type="text"], .table-toolbar select {
      padding: 0.45rem 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.35);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 0.85rem;
      outline: none;
    }
    .table-toolbar input[type="text"]:focus, .table-toolbar select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(59, 130, 212, 0.25);
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
    }
    .data-table th, .data-table td {
      padding: 0.65rem 0.95rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .data-table th {
      color: var(--text-secondary);
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }
    .data-table th:hover { color: var(--text-primary); }
    .data-table tr:hover td { background: rgba(255, 255, 255, 0.02); }

    /* Badges */
    .badge {
      display: inline-block;
      padding: 0.18rem 0.55rem;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .badge-core   { background: rgba(59, 130, 212, 0.2); color: #93c5fd; border: 1px solid rgba(59, 130, 212, 0.35); }
    .badge-api    { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.35); }
    .badge-model  { background: rgba(139, 92, 246, 0.2); color: #c4b5fd; border: 1px solid rgba(139, 92, 246, 0.35); }
    .badge-service{ background: rgba(245, 158, 11, 0.2); color: #fcd34d; border: 1px solid rgba(245, 158, 11, 0.35); }
    .badge-ui     { background: rgba(236, 72, 153, 0.2); color: #f472b6; border: 1px solid rgba(236, 72, 153, 0.35); }
    .badge-tier1  { background: linear-gradient(135deg, rgba(37,99,235,0.4), rgba(59,130,212,0.2)); color: #bfdbfe; font-weight: 700; border: 1px solid rgba(96,165,250,0.5); }
    .badge-tier2  { background: rgba(245, 158, 11, 0.15); color: #fde68a; border: 1px solid rgba(245, 158, 11, 0.3); }

    /* Complexity color */
    .complexity-high { color: var(--danger); font-weight: 600; }
    .complexity-mid  { color: var(--warn); font-weight: 500; }

    /* Contributor items */
    .contrib-avatar {
      width: 32px; height: 32px;
      border-radius: 50%;
      vertical-align: middle;
      margin-right: 0.6rem;
      border: 1px solid rgba(255,255,255,0.15);
      background: #1e293b;
    }
    .rank-medal { font-size: 1.1rem; margin-right: 0.3rem; }

    /* Mermaid Architecture Container */
    .mermaid-container {
      position: relative;
      background: #0d1117;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.5rem;
      overflow: hidden;
      min-height: 480px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    #main-mermaid-wrapper { cursor: grab; touch-action: none; user-select: none; }
    #main-mermaid-wrapper.dragging { cursor: grabbing; }
    #main-mermaid-canvas { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
    #main-mermaid-canvas svg { display: block; max-width: none; }
    .diagram-toolbar {
      position: absolute;
      top: 1rem; right: 1rem;
      display: flex; gap: 0.5rem;
      z-index: 10;
      background: rgba(13, 17, 23, 0.85);
      padding: 0.4rem;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.1);
      backdrop-filter: blur(8px);
    }
    .diagram-btn {
      padding: 0.35rem 0.65rem;
      font-size: 0.78rem;
      font-weight: 600;
      border-radius: 6px;
      background: rgba(255,255,255,0.06);
      color: var(--text-primary);
      border: 1px solid rgba(255,255,255,0.12);
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 0.3rem;
      transition: all 0.15s ease;
    }
    .diagram-btn:hover { background: rgba(59,130,212,0.25); border-color: var(--accent); }

    /* Modal Overlay */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      z-index: 999;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-overlay.active { display: flex; }
    .modal-card {
      background: #0f172a;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      max-width: 640px;
      width: 100%;
      padding: 1.75rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      position: relative;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .modal-title { font-size: 1.25rem; font-weight: 700; color: #ffffff; }
    .modal-close { background: none; border: none; font-size: 1.4rem; color: var(--text-secondary); cursor: pointer; }
    .modal-close:hover { color: #ffffff; }

    /* Toast */
    #toast-msg {
      position: fixed;
      bottom: 2rem; right: 2rem;
      background: #1e293b;
      border: 1px solid #3b82d4;
      color: #ffffff;
      padding: 0.65rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      font-size: 0.85rem;
      z-index: 10000;
      display: none;
      animation: fadeIn 0.2s ease;
    }

    /* ── Hero Section ───────────────────────────────────────────── */
    .hero-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding: 2.5rem 0 2rem;
      margin-bottom: 2rem;
      position: relative;
    }
    .hero-section::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 80% at 0% 50%, rgba(0,180,216,0.07), transparent),
        radial-gradient(ellipse 70% 80% at 100% 50%, rgba(59,130,212,0.06), transparent);
      pointer-events: none;
      border-radius: 1.5rem;
    }
    @media (max-width: 900px) { .hero-section { grid-template-columns: 1fr; } }

    .hero-left {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;
      padding: 2rem 1.75rem 2rem 0.5rem;
    }
    .hero-tagline {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #00b4d8;
    }
    .hero-headline {
      font-size: 2.6rem;
      font-weight: 800;
      line-height: 1.15;
      color: #ffffff;
      letter-spacing: -0.02em;
    }
    .hero-headline .hl-cyan { color: #38bdf8; }
    .hero-subtext {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.65;
      max-width: 440px;
    }
    /* Hero Right Column */
    .hero-right {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      padding: 1.25rem 0.5rem 1.25rem 1rem;
    }
    .hero-status-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(0,180,216,0.15);
      border-radius: 14px;
      padding: 0.85rem 1.1rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      backdrop-filter: blur(8px);
    }
    .hero-complete-icon {
      width: 36px; height: 36px; flex-shrink: 0;
      border-radius: 50%; display: grid; place-items: center;
      color: #6ee7b7; background: rgba(16,185,129,0.13);
      border: 1px solid rgba(110,231,183,0.5);
      box-shadow: 0 0 0 4px rgba(16,185,129,0.08);
    }
    .hero-explore-note {
      display: inline-flex; align-items: center; gap: 0.55rem;
      width: fit-content;
      padding: 0.65rem 0.9rem;
      border: 1px solid rgba(56,189,248,0.20);
      border-radius: 10px;
      background: rgba(56,189,248,0.06);
      color: #a9d9ed;
      font-size: 0.82rem;
    }
    .hero-status-info { flex: 1; min-width: 0; }
    .hero-status-title { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; color: #67e8f9; text-transform: uppercase; margin-bottom: 0.25rem; }
    .hero-status-sub { font-size: 0.72rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hero-progress-bar {
      height: 4px;
      background: rgba(255,255,255,0.08);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 0.4rem;
    }
    .hero-progress-fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, #10b981, #6ee7b7);
      border-radius: 4px;
    }
    .hero-progress-pct { font-size: 0.7rem; color: #6ee7b7; font-weight: 700; margin-left: auto; flex-shrink: 0; }

    .hero-canvas-wrap {
      position: relative;
      flex: 1;
      min-height: 220px;
      border-radius: 14px;
      overflow: hidden;
      background: rgba(0,10,28,0.5);
      border: 1px solid rgba(0,180,216,0.12);
    }
    #hero-topology-canvas { width: 100%; height: 100%; display: block; }

    .hero-map-overlay {
      position: absolute;
      top: 0.7rem; right: 0.7rem;
      background: rgba(7,11,20,0.88);
      border: 1px solid rgba(0,180,216,0.2);
      border-radius: 10px;
      padding: 0.55rem 0.85rem;
      backdrop-filter: blur(8px);
      min-width: 120px;
    }
    .hero-map-title { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.12em; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.4rem; }
    .hero-legend { display: flex; flex-direction: column; gap: 3px; }
    .hero-legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.65rem; color: var(--text-secondary); }
    .hero-legend-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .hero-legend-line { width: 14px; height: 1px; background: rgba(255,255,255,0.35); flex-shrink: 0; }

    .hero-metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
    }
    .hero-metric-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 0.9rem 0.85rem;
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      transition: border-color 0.15s ease;
    }
    .hero-metric-card:hover { border-color: rgba(0,180,216,0.22); }
    .hero-metric-icon { color: #00b4d8; flex-shrink: 0; margin-top: 2px; }
    .hero-metric-val { font-size: 1.2rem; font-weight: 800; color: #ffffff; line-height: 1.2; }
    .hero-metric-val em { color: #38bdf8; font-style: normal; }
    .hero-metric-label { font-size: 0.68rem; color: var(--text-secondary); margin-top: 2px; }
    .cg-intro h2 { color:#fff; font-size:1.35rem; margin-bottom:0.25rem; }
    .cg-intro p { color:var(--text-secondary); max-width:780px; font-size:0.84rem; }
    .cg-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0.7rem; margin:1.2rem 0; }
    .cg-metric { background:rgba(15,23,42,0.8); border:1px solid rgba(148,163,184,0.16); border-radius:10px; padding:0.8rem 1rem; }
    .cg-metric strong { display:block; color:#fff; font-size:1.2rem; }
    .cg-metric span { color:var(--text-secondary); font-size:0.75rem; }
    .cg-layout { display:grid; grid-template-columns:minmax(240px,0.9fr) minmax(0,1.6fr); gap:1rem; min-height:520px; }
    .cg-panel { min-width:0; background:rgba(8,16,30,0.65); border:1px solid rgba(148,163,184,0.15); border-radius:12px; padding:1rem; }
    .cg-panel h3 { color:#fff; font-size:0.98rem; }
    .cg-panel-note { color:var(--text-secondary); font-size:0.76rem; margin:0.25rem 0 0.85rem; }
    .cg-search { width:100%; padding:0.62rem 0.75rem; border-radius:8px; border:1px solid rgba(148,163,184,0.3); background:#0b1423; color:var(--text-primary); font:inherit; }
    .cg-search:focus { outline:2px solid rgba(56,189,248,0.4); }
    .cg-caller-list { max-height:520px; overflow-y:auto; margin-top:0.75rem; }
    .cg-file-group { border:1px solid rgba(148,163,184,0.12); border-radius:8px; margin-bottom:0.55rem; overflow:hidden; }
    .cg-file-group summary { cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:0.6rem; padding:0.7rem; color:#cbd5e1; background:rgba(30,41,59,0.42); font-size:0.78rem; overflow-wrap:anywhere; }
    .cg-file-group summary:hover { background:rgba(30,58,90,0.6); }
    .cg-file-group summary span { color:#67e8f9; flex-shrink:0; }
    .cg-caller { width:100%; border:0; border-top:1px solid rgba(148,163,184,0.09); background:transparent; color:#e2e8f0; padding:0.58rem 0.7rem; display:flex; justify-content:space-between; gap:0.5rem; text-align:left; cursor:pointer; font:inherit; font-size:0.79rem; }
    .cg-caller:hover, .cg-caller.active { background:rgba(14,116,144,0.2); color:#fff; }
    .cg-caller span:first-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .cg-caller span:last-child { color:#67e8f9; }
    .cg-selected-path { color:#93c5fd; font-size:0.78rem; overflow-wrap:anywhere; margin:0.35rem 0; }
    .cg-source-link { display:inline-block; color:#7dd3fc; text-decoration:none; font-size:0.78rem; margin-bottom:0.7rem; }
    .cg-source-link:hover { text-decoration:underline; }
    .cg-empty { color:var(--text-secondary); padding:1.5rem 0.5rem; font-size:0.83rem; }
    .cg-table-scroll { max-height:560px; overflow:auto; border-top:1px solid rgba(148,163,184,0.12); }
    .cg-table-scroll th { position:sticky; top:0; z-index:1; background:#101c2a; }
    @media (max-width: 800px) { .cg-layout { grid-template-columns:1fr; } .cg-caller-list { max-height:280px; } }
    @media (max-width: 640px) {
      .sidebar, .sidebar.collapsed { width: 52px; }
      .sidebar-brand-text, .sidebar-nav-label, .sidebar-footer-label { display: none; }
      #main-layout, #main-layout.sidebar-collapsed { margin-left: 52px; width: calc(100% - 52px); }
      .nav-bar { padding: 0.6rem; flex-wrap: wrap; }
      .nav-bar .repo-badge { max-width: 150px; }
      .tab-content { padding: 0.75rem; }
      .hero-section { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
      .hero-left, .hero-right { min-width: 0; padding: 1rem 0; }
      .hero-headline { font-size: clamp(1.5rem, 7vw, 2rem); overflow-wrap: anywhere; }
      .hero-metrics, .stat-cards { grid-template-columns: minmax(0, 1fr); }
      .bento-grid { grid-template-columns: minmax(0, 1fr); }
      .bento-col-4, .bento-col-6, .bento-col-8, .bento-col-12 { grid-column: 1; }
      .cg-metrics { grid-template-columns:1fr; }
    }
  </style>
</head>
<body>

<!-- ── Collapsible Left Sidebar ─────────────────────────────────── -->
<nav class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
  <!-- Header: Logo + Brand + Collapse Toggle -->
  <div class="sidebar-header">
    <div class="sidebar-brand">
      <div class="sidebar-logo-icon">
        <svg width="24" height="24" viewBox="0 0 40 40" fill="none" role="img" aria-label="Code Compass logo">
          <circle cx="20" cy="20" r="15" stroke="white" stroke-opacity=".75" stroke-width="2"/>
          <path d="M20 2v6M20 32v6M2 20h6M32 20h6" stroke="white" stroke-opacity=".5" stroke-width="2" stroke-linecap="round"/>
          <path d="m25.8 14.2-3.7 7.9-7.9 3.7 3.7-7.9 7.9-3.7Z" fill="white"/>
          <circle cx="20" cy="20" r="2.2" fill="#075985"/>
        </svg>
      </div>
      <span class="sidebar-brand-text">CODE<br>COMPASS</span>
    </div>
    <button class="sidebar-toggle" id="sidebar-toggle" type="button" title="Collapse sidebar" aria-label="Collapse sidebar" aria-expanded="true" aria-controls="sidebar-nav"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="3.5" width="19" height="17" rx="3"/><path d="M9 4v16M16 9l-3 3 3 3"/></svg></button>
  </div>

  <!-- Nav Items -->
  <div class="sidebar-nav" id="sidebar-nav" role="tablist">
    <button class="sidebar-nav-btn active" role="tab" aria-selected="true" aria-controls="tab-overview" data-tab="overview" data-tooltip="Overview">
      <span class="sidebar-nav-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      </span>
      <span class="sidebar-nav-label">Overview</span>
    </button>
    <button class="sidebar-nav-btn" role="tab" aria-selected="false" aria-controls="tab-prompt" data-tab="prompt" data-tooltip="System Prompt">
      <span class="sidebar-nav-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </span>
      <span class="sidebar-nav-label">System Prompt</span>
    </button>
    <button class="sidebar-nav-btn" role="tab" aria-selected="false" aria-controls="tab-architecture" data-tab="architecture" data-tooltip="Architecture">
      <span class="sidebar-nav-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><line x1="12" y1="7" x2="5" y2="17"/><line x1="12" y1="7" x2="19" y2="17"/></svg>
      </span>
      <span class="sidebar-nav-label">Architecture</span>
    </button>
    <button class="sidebar-nav-btn" role="tab" aria-selected="false" aria-controls="tab-callgraph" data-tab="callgraph" data-tooltip="Call Graph">
      <span class="sidebar-nav-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </span>
      <span class="sidebar-nav-label">Call Graph</span>
    </button>
    <button class="sidebar-nav-btn" role="tab" aria-selected="false" aria-controls="tab-contributors" data-tab="contributors" data-tooltip="Contributors">
      <span class="sidebar-nav-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span class="sidebar-nav-label">Contributors</span>
    </button>
    <button class="sidebar-nav-btn" role="tab" aria-selected="false" aria-controls="tab-semantic" data-tab="semantic" data-tooltip="Semantic Audit">
      <span class="sidebar-nav-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </span>
      <span class="sidebar-nav-label">Semantic Audit</span>
    </button>
  </div>

  <!-- Footer: Open Summary Explorer -->
  <div class="sidebar-footer">
    <button class="sidebar-footer-btn" id="btn-open-summary-sidebar" onclick="window.open(window.__SUMMARY_URL__,'_blank');" title="Open Summary Explorer">
      <span class="sidebar-nav-icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </span>
      <span class="sidebar-footer-label">Summary Explorer</span>
    </button>
  </div>
</nav>

<!-- ── Main Layout Wrapper ───────────────────────────────────────── -->
<div id="main-layout">

<!-- ── Top Navigation Bar ───────────────────────────────────────── -->
<header class="nav-bar">
  <div class="nav-left">
    <span class="app-name">Code Compass</span>
    <span class="repo-badge" id="nav-repo-path">{{ repo_name }}</span>
  </div>
  <nav class="nav-actions">
    <a href="/" class="new-analysis-link" id="new-analysis-link"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Analyse new repo</a>
    <a href="https://github.com/Gracy769/code-compass-app#readme" target="_blank" rel="noopener noreferrer" class="nav-link">Docs</a>
    {% if github_slug %}
    <a href="https://github.com/{{ github_slug }}" target="_blank" rel="noopener noreferrer" class="nav-link">GitHub</a>
    {% endif %}
  </nav>
</header>

<!-- ── Content Container ───────────────────────────────────────── -->
<div class="tab-content">

  <!-- ── 1. OVERVIEW TAB ─────────────────────────────────────── -->
  <section id="tab-overview" class="tab-section active" role="tabpanel">

    <!-- ── HERO SECTION ────────────────────────────────────────── -->
    <div class="hero-section">
      <!-- Left Column: Current repository guide -->
      <div class="hero-left">
        <p class="hero-tagline">Your codebase, mapped</p>
        <h1 class="hero-headline">Explore <span class="hl-cyan">{{ repo_name }}</span></h1>
        <p class="hero-subtext">The analysis is ready. Follow the map into files, trace calls between symbols, and use the navigation to understand how this repository fits together.</p>
        <div class="hero-explore-note"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg>Choose a section in the sidebar to start exploring</div>
      </div>

      <!-- Right Column: Network Topology + Metrics -->
      <div class="hero-right">
        <!-- Status Card -->
        <div class="hero-status-card">
          <div class="hero-complete-icon" role="img" aria-label="Analysis complete">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg>
          </div>
          <div class="hero-status-info">
            <div class="hero-status-title">Analysis complete</div>
            <div class="hero-status-sub">Results from this repository</div>
            <div style="display:flex;align-items:center;gap:0.6rem;margin-top:0.4rem;">
              <div class="hero-progress-bar" style="flex:1;"><div class="hero-progress-fill"></div></div>
              <span class="hero-progress-pct">100%</span>
            </div>
          </div>
        </div>

        <!-- Canvas: Topology Network -->
        <div class="hero-canvas-wrap">
          <canvas id="hero-topology-canvas"></canvas>
          <!-- Codebase Map Mini Overlay -->
          <div class="hero-map-overlay">
            <div class="hero-map-title">Codebase Map</div>
            <div class="hero-legend">
              <div class="hero-legend-item"><span class="hero-legend-dot" style="background:#38bdf8;"></span> Module</div>
              <div class="hero-legend-item"><span class="hero-legend-line"></span> Dependency</div>
              <div class="hero-legend-item"><span class="hero-legend-dot" style="background:#fbbf24;"></span> Top ranked file</div>
            </div>
          </div>
        </div>

        <!-- Bottom 3 Metric Cards -->
        <div class="hero-metrics">
          <div class="hero-metric-card">
            <div class="hero-metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div>
              <div class="hero-metric-val"><em id="hero-files-count">—</em> Files</div>
              <div class="hero-metric-label">Scanned and indexed</div>
            </div>
          </div>
          <div class="hero-metric-card">
            <div class="hero-metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <div>
              <div class="hero-metric-val"><em id="hero-analysis-time">—</em> AST</div>
              <div class="hero-metric-label">Parse and analyze</div>
            </div>
          </div>
          <div class="hero-metric-card">
            <div class="hero-metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <div class="hero-metric-val"><em id="hero-panic-count">—</em> High findings</div>
              <div class="hero-metric-label" id="hero-panic-label">Semantic audit status</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- /hero-section -->

    <!-- Top Summary Stat Cards -->
    <div class="stat-cards" id="overview-cards"></div>

    <div class="bento-grid">
      <!-- Health & Architecture Scorecard -->
      <div class="section-card bento-col-4">
        <h3 style="margin-bottom: 1rem; display:flex; align-items:center; gap:0.5rem; color:#fff;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          Repo Health Scorecard
        </h3>
        <div style="display:flex; align-items:center; gap:1.25rem; margin-bottom:1.25rem;">
          <div class="health-badge" id="health-gauge">
            <div class="health-inner" id="health-inner">96</div>
          </div>
          <div>
            <div style="font-weight:700; font-size:1.05rem; color:#ffffff;" id="health-tier">Excellent Health</div>
            <div style="font-size:0.8rem; color:var(--text-secondary);">Estimated structural score from complexity</div>
          </div>
        </div>
        <div style="display:flex; flex-direction:column; gap:0.55rem; font-size:0.82rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Modularity Index</span>
            <span style="color:#86efac; font-weight:600;">Not measured</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Cyclomatic Complexity</span>
            <span style="color:#93c5fd; font-weight:600;" id="overview-avg-complexity">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Dead Code Ratio</span>
            <span style="color:#fbbf24; font-weight:600;" id="overview-dead-ratio">0.0%</span>
          </div>
        </div>
      </div>

      <!-- Repository Architecture Matrix & Summary -->
      <div class="section-card bento-col-8" style="overflow-x:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
          <h3 style="display:flex; align-items:center; gap:0.5rem; color:#fff;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82d4" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            Repository Architecture Matrix
          </h3>
          <button class="action-btn action-btn-primary" id="btn-open-summary" onclick="window.open(window.__SUMMARY_URL__,'_blank');">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Open Summary &rarr;
          </button>
        </div>
        <table style="width:100%; border-collapse:collapse; font-size:0.83rem; table-layout:fixed;">
          <thead>
            <tr>
