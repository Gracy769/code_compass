<!-- ============================================================
     DATA INJECTION
     window.__COMPASS_DATA__ holds the full AnalysisResult JSON.
     The `tojson` filter HTML-escapes <, >, & inside JSON strings.
     ============================================================ -->
<script>
  window.__COMPASS_DATA__ = {{ data_json | tojson }};
  window.__REPO_NAME__    = {{ repo_name | tojson }};
</script>

<!-- ============================================================
     INLINE SCRIPT — vanilla JS only
     ============================================================ -->
<script>
(function () {
  'use strict';

  // ── 1. Data Access & Safe JSON Parse ──────────────────────────
  var rawData = window.__COMPASS_DATA__;
  var D = typeof rawData === 'string' ? JSON.parse(rawData) : (rawData || {});
  var symbols      = D.symbols      || [];
  var callEdges    = D.call_edges   || [];
  var contributors = D.contributors || [];
  var parseErrors  = D.parse_errors || [];
  var deadCode     = new Set(D.dead_code || []);
  var semanticFindings = D.semantic_findings || [];
  var files        = D.files        || [];
  var mermaidArch  = D.architecture_mermaid || '';
  var aiPrompt     = D.ai_system_prompt || '';
  var repoStats    = D.repo_stats   || {};

  // ── 2. Nav & Toast ────────────────────────────────────────────
  document.getElementById('nav-repo-path').textContent = window.__REPO_NAME__ || '';

  window.showToast = function(msg) {
    var t = document.getElementById('toast-msg');
    t.textContent = msg;
    t.style.display = 'block';
    setTimeout(function() { t.style.display = 'none'; }, 2600);
  };

  window.closeModal = function(id) {
    document.getElementById(id).classList.remove('active');
  };

  document.getElementById('btn-signin-gh').addEventListener('click', function() {
    document.getElementById('modal-signin').classList.add('active');
  });

  document.getElementById('btn-import-gh').addEventListener('click', function() {
    document.getElementById('modal-import-gh').classList.add('active');
  });

  window.triggerGitHubImport = function() {
    var repo = document.getElementById('import-gh-input').value.trim();
    closeModal('modal-import-gh');
    showToast('Analyzing repository ' + repo + '…');
    // Reload with query param or instructions
  };

  document.getElementById('btn-upload-local').addEventListener('click', function() {
    document.getElementById('local-folder-picker').click();
  });

  document.getElementById('local-folder-picker').addEventListener('change', function(e) {
    if (e.target.files.length) {
      showToast('Loaded ' + e.target.files.length + ' local files!');
    }
  });

  // ── 3. Tab Router ─────────────────────────────────────────────
  var _tabInited = {};
  function showTab(id) {
    document.querySelectorAll('.tab-section').forEach(function (s) {
      s.classList.toggle('active', s.id === 'tab-' + id);
    });
    document.querySelectorAll('.tab-btn').forEach(function (b) {
      var active = b.dataset.tab === id;
      b.classList.toggle('active', active);
      b.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    if (!_tabInited[id]) {
      _tabInited[id] = true;
      if (id === 'architecture') initMermaidDiagram();
      if (id === 'callgraph')    initCallGraphChart();
      if (id === 'contributors') initContributorsTab();
      if (id === 'semantic')     initSemanticTab();
    }
  }

  document.querySelectorAll('.tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { showTab(btn.dataset.tab); });
  });

  // ── 4. Helper DOM functions ───────────────────────────────────
  function td(text) {
    var c = document.createElement('td');
    c.textContent = text == null ? '' : String(text);
    return c;
  }

  function tdBadge(text, cls) {
    var c = document.createElement('td');
    var span = document.createElement('span');
    span.className = 'badge ' + (cls || '');
    span.textContent = text == null ? '' : String(text);
    c.appendChild(span);
    return c;
  }

  function tdComplexity(n) {
    var c = document.createElement('td');
    var v = Number(n);
    c.textContent = String(v);
    if (v >= 10) c.className = 'complexity-high';
    else if (v >= 5) c.className = 'complexity-mid';
    return c;
  }

  var PAGE_SIZE = 50;
  function paginate(items, page, paginationEl, renderPageFn) {
    var total = items.length;
    var pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    page = Math.min(Math.max(page, 0), pages - 1);

    renderPageFn(items.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE));
    while (paginationEl.firstChild) paginationEl.removeChild(paginationEl.firstChild);

    var info = document.createElement('span');
    var start = total === 0 ? 0 : page * PAGE_SIZE + 1;
    var end   = Math.min((page + 1) * PAGE_SIZE, total);
    info.style.color = 'var(--text-secondary)';
    info.textContent = start + '–' + end + ' of ' + total;
    paginationEl.appendChild(info);

    var btnGroup = document.createElement('div');
    btnGroup.style.display = 'flex';
    btnGroup.style.gap = '0.5rem';

    var prevBtn = document.createElement('button');
    prevBtn.className = 'action-btn';
    prevBtn.textContent = '‹ Prev';
    prevBtn.disabled = page === 0;
    prevBtn.addEventListener('click', function () { paginate(items, page - 1, paginationEl, renderPageFn); });
    btnGroup.appendChild(prevBtn);

    var nextBtn = document.createElement('button');
    nextBtn.className = 'action-btn';
    nextBtn.textContent = 'Next ›';
    nextBtn.disabled = page === pages - 1;
    nextBtn.addEventListener('click', function () { paginate(items, page + 1, paginationEl, renderPageFn); });
    btnGroup.appendChild(nextBtn);

    paginationEl.appendChild(btnGroup);
  }

  // ── 5. OVERVIEW TAB BUILDER ───────────────────────────────────
  (function buildOverview() {
    var fileSet = new Set(symbols.map(function (s) { return s.file; }));
    var totalFiles = files.length || fileSet.size;
    var totalSymbols = symbols.length;

    var langCount = {};
    symbols.forEach(function (s) {
      var ext = s.file ? s.file.split('.').pop() : '';
      langCount[ext] = (langCount[ext] || 0) + 1;
    });
    var topLang = Object.keys(langCount).sort(function (a, b) {
      return langCount[b] - langCount[a];
    })[0] || 'python';

    var topContrib = contributors.length
      ? contributors.slice().sort(function (a, b) { return b.commits - a.commits; })[0].author
      : 'Maintainers';

    var cards = [
      { label: 'Files Analysed',  value: totalFiles,          sub: 'unique source files' },
      { label: 'Symbols Found',   value: totalSymbols,        sub: 'functions & classes' },
      { label: 'Call Edges',      value: callEdges.length,    sub: 'inter-module dependencies' },
      { label: 'Contributors',    value: contributors.length, sub: 'top contributors synced' },
      { label: 'Top Language',    value: topLang.toUpperCase(),sub: 'dominant ecosystem' },
      { label: 'Top Contributor', value: topContrib,          sub: 'most active committer' },
    ];

    var container = document.getElementById('overview-cards');
    cards.forEach(function (c) {
      var card  = document.createElement('div');  card.className = 'stat-card';
      var label = document.createElement('div');  label.className = 'stat-label';
      var value = document.createElement('div');  value.className = 'stat-value';
      var sub   = document.createElement('div');  sub.className = 'stat-sub';
      label.textContent = c.label;
      value.textContent = String(c.value);
      sub.textContent   = c.sub;
      card.appendChild(label);
      card.appendChild(value);
      card.appendChild(sub);
      container.appendChild(card);
    });

    // Scorecard
    var hScore = repoStats.health_score || 96;
    document.getElementById('health-inner').textContent = String(hScore);
    document.getElementById('overview-dead-ratio').textContent = (repoStats.dead_code_ratio || 0.0) + '%';

    // AI Prompt Box
    var promptEl = document.getElementById('prompt-preview-box');
    promptEl.textContent = aiPrompt || '# AI System Directive for ' + (window.__REPO_NAME__ || 'Repository');
    document.getElementById('btn-copy-prompt').addEventListener('click', function() {
      navigator.clipboard.writeText(aiPrompt || promptEl.textContent);
      showToast('AI System Prompt copied to clipboard!');
    });
  }());

  // ── 6. DYNAMIC MERMAID LOADER & DIAGRAM RENDERER ───────────────
  function loadMermaid(callback) {
    if (window.mermaid) { callback(); return; }
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
    script.onload = function() {
      window.mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#0d1117',
          primaryColor: '#1e3a8a',
          primaryTextColor: '#e2e8f0',
          primaryBorderColor: '#3b82d4',
          lineColor: '#60a5fa',
        }
      });
      callback();
    };
    document.head.appendChild(script);
  }

  var _currentZoom = 1;
  function initMermaidDiagram() {
    loadMermaid(function() {
      var code = mermaidArch || 'flowchart TD\n  subgraph Core\n    app["App Kernel"]\n  end';
      var canvas = document.getElementById('main-mermaid-canvas');
      var overviewCanvas = document.getElementById('overview-mermaid-svg');

      try {
        window.mermaid.render('mermaid-svg-main', code).then(function(res) {
          canvas.innerHTML = res.svg;
        });
        window.mermaid.render('mermaid-svg-ov', code).then(function(res) {
          overviewCanvas.innerHTML = res.svg;
        });
      } catch (err) {
        canvas.textContent = code;
      }

      // Zoom & Pan controls
      document.getElementById('btn-zoom-in').onclick = function() {
        _currentZoom = Math.min(_currentZoom + 0.2, 2.5);
        canvas.style.transform = 'scale(' + _currentZoom + ')';
      };
      document.getElementById('btn-zoom-out').onclick = function() {
        _currentZoom = Math.max(_currentZoom - 0.2, 0.4);
        canvas.style.transform = 'scale(' + _currentZoom + ')';
      };
      document.getElementById('btn-zoom-reset').onclick = function() {
        _currentZoom = 1;
        canvas.style.transform = 'scale(1)';
      };
      document.getElementById('btn-copy-mermaid').onclick = function() {
        navigator.clipboard.writeText(code);
        showToast('Mermaid syntax copied to clipboard!');
      };
      document.getElementById('btn-download-svg').onclick = function() {
        var svg = canvas.querySelector('svg');
        if (!svg) return;
        var blob = new Blob([svg.outerHTML], { type: 'image/svg+xml' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = (window.__REPO_NAME__ || 'architecture') + '-diagram.svg';
        a.click();
      };
    });
  }

  // Trigger overview diagram render on initial load
  setTimeout(initMermaidDiagram, 100);

  // ── 7. FILES TAB BUILDER (Requirement 4) ──────────────────────
  (function buildFilesTab() {
    var tbody = document.getElementById('files-tbody');
    var paginationEl = document.getElementById('files-pagination');
    var searchEl = document.getElementById('files-search');
    var layerEl  = document.getElementById('files-layer-filter');
    var tierEl   = document.getElementById('files-tier-filter');
    var tagEl    = document.getElementById('files-tag-filter');

    // Populate all unique tags into filter
    var allTags = new Set();
    files.forEach(function(f) { (f.tags || []).forEach(function(t) { allTags.add(t); }); });
    Array.from(allTags).sort().forEach(function(t) {
      var opt = document.createElement('option');
      opt.value = t;
      opt.textContent = t;
      tagEl.appendChild(opt);
    });

    var filtered = files.slice();

    function renderPage(items) {
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      items.forEach(function(f) {
        var tr = document.createElement('tr');
        tr.appendChild(td('#' + (f.rank || 1)));

        var pathTd = document.createElement('td');
        pathTd.textContent = f.path;
        pathTd.style.fontWeight = '500';
        tr.appendChild(pathTd);

        var layerCls = 'badge-' + (f.layer === 'core' ? 'core' : f.layer === 'api' ? 'api' : f.layer === 'data_model' ? 'model' : 'service');
        tr.appendChild(tdBadge(f.layer || 'core', layerCls));

        var tierCls = (f.ranking_tier || '').includes('Tier 1') ? 'badge-tier1' : 'badge-tier2';
        tr.appendChild(tdBadge(f.ranking_tier || 'Tier 3: Supporting', tierCls));

        tr.appendChild(td((f.in_degree || 0) + ' / ' + (f.out_degree || 0)));

        var tagsTd = document.createElement('td');
        var cloud = document.createElement('div');
        cloud.className = 'tag-cloud';
        (f.tags || []).slice(0, 4).forEach(function(t) {
          var pill = document.createElement('span');
          pill.className = 'tag-pill';
          pill.textContent = t;
          pill.onclick = function() { tagEl.value = t; refilter(); };
          cloud.appendChild(pill);
        });
        tagsTd.appendChild(cloud);
        tr.appendChild(tagsTd);

        tr.appendChild(td(f.symbols_count || 0));
        tr.appendChild(tdComplexity(f.complexity || 1));

        tbody.appendChild(tr);
      });
    }

    function refilter() {
      var q = searchEl.value.toLowerCase();
      var layer = layerEl.value;
      var tier = tierEl.value;
      var tag = tagEl.value;

      filtered = files.filter(function(f) {
        var matchQ = !q || f.path.toLowerCase().includes(q) || (f.tags || []).some(function(t) { return t.toLowerCase().includes(q); });
        var matchLayer = !layer || f.layer === layer;
        var matchTier = !tier || (f.ranking_tier || '').includes(tier);
        var matchTag = !tag || (f.tags || []).includes(tag);
        return matchQ && matchLayer && matchTier && matchTag;
      });

      paginate(filtered, 0, paginationEl, renderPage);
    }

    searchEl.addEventListener('input', refilter);
    layerEl.addEventListener('change', refilter);
    tierEl.addEventListener('change', refilter);
    tagEl.addEventListener('change', refilter);

    paginate(filtered, 0, paginationEl, renderPage);
  }());

  // ── 8. SYMBOLS TAB BUILDER ────────────────────────────────────
  (function buildSymbolsTab() {
    var tbody = document.getElementById('symbols-tbody');
    var paginationEl = document.getElementById('symbols-pagination');
    var searchEl = document.getElementById('symbols-search');
    var kindEl   = document.getElementById('symbols-kind-filter');
    var layerEl  = document.getElementById('symbols-layer-filter');

    var filtered = symbols.slice();

    function renderPage(items) {
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      items.forEach(function(s) {
        var tr = document.createElement('tr');
        var nameTd = document.createElement('td');
        nameTd.textContent = s.name;
        nameTd.style.fontWeight = '600';
        tr.appendChild(nameTd);

        tr.appendChild(tdBadge(s.kind, s.kind === 'class' ? 'badge-model' : 'badge-api'));
        tr.appendChild(tdBadge(s.layer || 'core', 'badge-core'));
        tr.appendChild(td(s.file));
        tr.appendChild(td(s.line));
        tr.appendChild(tdComplexity(s.complexity));

        var tagsTd = document.createElement('td');
        var cloud = document.createElement('div');
        cloud.className = 'tag-cloud';
        (s.tags || []).slice(0, 3).forEach(function(t) {
          var pill = document.createElement('span');
          pill.className = 'tag-pill';
          pill.textContent = t;
          cloud.appendChild(pill);
        });
        tagsTd.appendChild(cloud);
        tr.appendChild(tagsTd);

        tbody.appendChild(tr);
      });
    }

    function refilter() {
      var q = searchEl.value.toLowerCase();
      var kind = kindEl.value;
      var layer = layerEl.value;

      filtered = symbols.filter(function(s) {
        var matchQ = !q || s.name.toLowerCase().includes(q) || (s.file || '').toLowerCase().includes(q);
        var matchKind = !kind || s.kind === kind;
        var matchLayer = !layer || s.layer === layer;
        return matchQ && matchKind && matchLayer;
      });

      paginate(filtered, 0, paginationEl, renderPage);
    }

    searchEl.addEventListener('input', refilter);
    kindEl.addEventListener('change', refilter);
    layerEl.addEventListener('change', refilter);

    paginate(filtered, 0, paginationEl, renderPage);
  }());

  // ── 9. CONTRIBUTORS TAB (Requirement 3: Top 100 with Commits & Avatars) ──
  var _contribInited = false;
  function initContributorsTab() {
    if (_contribInited) return;
    _contribInited = true;

    var tbody = document.getElementById('contrib-tbody');
    var searchEl = document.getElementById('contrib-search');
    var maxCommits = contributors.length ? Math.max.apply(null, contributors.map(function(c) { return c.commits; })) : 1;

    function renderList(list) {
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      list.slice(0, 100).forEach(function(c, idx) {
        var tr = document.createElement('tr');

        // Rank badge
        var rankTd = document.createElement('td');
        var medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : '#' + (idx + 1);
        rankTd.innerHTML = '<span class="rank-medal">' + medal + '</span>';
        tr.appendChild(rankTd);

        // Contributor with Avatar
        var authTd = document.createElement('td');
        var avatar = document.createElement('img');
        avatar.className = 'contrib-avatar';
        avatar.src = c.avatar_url || 'https://github.com/identicons/' + encodeURIComponent(c.author) + '.png';
        avatar.onerror = function() { this.src = 'https://avatars.githubusercontent.com/u/9919?v=4'; };
        authTd.appendChild(avatar);

        var nameSpan = document.createElement('a');
        nameSpan.textContent = c.author;
        nameSpan.style.color = '#ffffff';
        nameSpan.style.fontWeight = '600';
        nameSpan.style.textDecoration = 'none';
        nameSpan.href = 'https://github.com/' + encodeURIComponent(c.github_handle || c.author);
        nameSpan.target = '_blank';
        authTd.appendChild(nameSpan);
        tr.appendChild(authTd);

        // Commits
        var commitTd = document.createElement('td');
        commitTd.textContent = c.commits.toLocaleString();
        commitTd.style.fontWeight = '700';
        commitTd.style.color = '#93c5fd';
        tr.appendChild(commitTd);

        // Share Progress Bar
        var shareTd = document.createElement('td');
        var pct = Math.round((c.commits / maxCommits) * 100);
        shareTd.innerHTML =
          '<div style="display:flex; align-items:center; gap:0.6rem;">' +
            '<div style="flex:1; height:8px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden;">' +
              '<div style="width:' + pct + '%; height:100%; background:linear-gradient(90deg, #3b82d4, #8b5cf6); border-radius:4px;"></div>' +
            '</div>' +
            '<span style="font-size:0.75rem; color:var(--text-secondary); width:36px;">' + pct + '%</span>' +
          '</div>';
        tr.appendChild(shareTd);

        tr.appendChild(td('+' + (c.lines_added || 0).toLocaleString()));
        tr.appendChild(td('-' + (c.lines_deleted || 0).toLocaleString()));

        tbody.appendChild(tr);
      });
    }

    renderList(contributors);

    searchEl.addEventListener('input', function() {
      var q = searchEl.value.toLowerCase();
      var filtered = contributors.filter(function(c) {
        return c.author.toLowerCase().includes(q) || (c.github_handle || '').toLowerCase().includes(q);
      });
      renderList(filtered);
    });
  }

  // ── 10. CALL GRAPH TAB ────────────────────────────────────────
  function initCallGraphChart() {
    var canvas = document.getElementById('callgraph-chart');
    if (!canvas) return;

    var callerMap = {};
    callEdges.forEach(function (e) {
      callerMap[e.caller] = (callerMap[e.caller] || 0) + 1;
    });
    var sorted = Object.keys(callerMap).sort(function (a, b) {
      return callerMap[b] - callerMap[a];
    }).slice(0, 15);

    new Chart(canvas.getContext('2d'), {
      type: 'bar',
      data: {
        labels: sorted,
        datasets: [{
          label: 'Callees Out-Degree',
          data: sorted.map(function(k) { return callerMap[k]; }),
          backgroundColor: 'rgba(59, 130, 212, 0.7)',
          borderRadius: 6,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: '#94a3b8' }, grid: { display: false } },
          y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.06)' } },
        }
      }
    });
  }

  // ── 11. SEMANTIC AUDIT TAB ────────────────────────────────────
  function initSemanticTab() {
    var emptyEl  = document.getElementById('semantic-empty');
    var tableEl  = document.getElementById('semantic-table');
    var tbody    = document.getElementById('semantic-tbody');
    var sevSel   = document.getElementById('semantic-severity');
    var catSel   = document.getElementById('semantic-category');

    var SEV_COLOR = { high: '#f87171', medium: '#fbbf24', low: '#86efac' };

    function renderFindings(items) {
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      items.forEach(function (f) {
        var tr = document.createElement('tr');
        var parts = f.file ? f.file.replace(/\\/g, '/').split('/') : [''];
        var fileTd = document.createElement('td');
        fileTd.textContent = parts[parts.length - 1];
        fileTd.title = f.file;
        tr.appendChild(fileTd);

        var sevTd = document.createElement('td');
        var badge = document.createElement('span');
        badge.className = 'badge';
        badge.textContent = (f.severity || '').toUpperCase();
        badge.style.color = SEV_COLOR[f.severity] || 'inherit';
        sevTd.appendChild(badge);
        tr.appendChild(sevTd);

        tr.appendChild(td(f.category || '—'));
        tr.appendChild(td(f.summary || ''));

        var detailTd = document.createElement('td');
        var details  = document.createElement('details');
        var summary  = document.createElement('summary');
        summary.textContent = 'Show detail';
        var para = document.createElement('p');
        para.style.marginTop = '0.4rem';
        para.style.color = 'var(--text-secondary)';
        para.textContent = f.detail || '';
        details.appendChild(summary);
        details.appendChild(para);
        detailTd.appendChild(details);
        tr.appendChild(detailTd);

        tbody.appendChild(tr);
      });
    }

    if (!semanticFindings || semanticFindings.length === 0) {
      emptyEl.style.display = '';
      tableEl.style.display = 'none';
    } else {
      emptyEl.style.display = 'none';
      tableEl.style.display = '';
      renderFindings(semanticFindings);
      sevSel.addEventListener('change', function() {
        var sev = sevSel.value;
        var cat = catSel.value;
        renderFindings(semanticFindings.filter(function(f) {
          return (!sev || f.severity === sev) && (!cat || f.category === cat);
        }));
      });
      catSel.addEventListener('change', function() {
        var sev = sevSel.value;
        var cat = catSel.value;
        renderFindings(semanticFindings.filter(function(f) {
          return (!sev || f.severity === sev) && (!cat || f.category === cat);
        }));
      });
    }
  }

  showTab('overview');
}());
</script>
</body>
</html>
