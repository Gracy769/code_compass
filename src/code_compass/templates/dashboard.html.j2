  // ── 6. DYNAMIC MERMAID LOADER & DIAGRAM RENDERER ───────────────
  function loadMermaid(callback) {
    if (window.mermaid) { callback(true); return; }
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10.9.5/dist/mermaid.min.js';
    script.integrity = 'sha384-enVdc7lTHDGtpROV85t9+VqPC2EyyB0hsRD0MrvQnHUsHmTHIz2D8SPP4EnBkstH';
    script.crossOrigin = 'anonymous';
    script.onload = function() {
      window.mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#0d1117',
          primaryColor: '#1e3a8a',
          primaryTextColor: '#e2e8f0',
          primaryBorderColor: '#3b82d4',
          lineColor: '#60a5fa',
        }
      });
      callback(true);
    };
    script.onerror = function() { callback(false); };
    document.head.appendChild(script);
  }

  function _applySvgSize(container, minH) {
    var svg = container.querySelector('svg');
    if (svg) {
      svg.style.width = '100%';
      svg.style.minHeight = (minH || 480) + 'px';
      svg.style.height = 'auto';
    }
  }

  var _mermaidStarted = false;
  var fitDiagram = function() {};
  var focusDiagram = function() {};
  function initMermaidDiagram() {
    if (_mermaidStarted) return;
    _mermaidStarted = true;
    loadMermaid(function(loaded) {
      if (!loaded) {
        document.getElementById('main-mermaid-canvas').textContent = 'Diagram library could not load. Check your connection and reopen Architecture.';
        document.getElementById('overview-mermaid-svg').textContent = 'Diagram unavailable while the library is offline.';
        _mermaidStarted = false;
        return;
      }
      var code = mermaidArch || 'flowchart TD\n  subgraph Core\n    app["App Kernel"]\n  end';
      var canvas = document.getElementById('main-mermaid-canvas');
      var overviewCanvas = document.getElementById('overview-mermaid-svg');
      var wrapper = document.getElementById('main-mermaid-wrapper');
      var scale = 1, panX = 0, panY = 0, diagramWidth = 800, diagramHeight = 600;
      function applyView() {
        canvas.style.transform = 'translate(' + panX + 'px,' + panY + 'px) scale(' + scale + ')';
      }
      fitDiagram = function() {
        if (!canvas.querySelector('svg') || !wrapper.clientWidth) return;
        scale = Math.max(0.1, Math.min(2, (wrapper.clientWidth - 40) / diagramWidth,
          (wrapper.clientHeight - 40) / diagramHeight));
        panX = (wrapper.clientWidth - diagramWidth * scale) / 2;
        panY = (wrapper.clientHeight - diagramHeight * scale) / 2;
        applyView();
      };
      function zoomAt(factor, x, y) {
        var next = Math.max(0.1, Math.min(5, scale * factor));
        panX = x - (x - panX) * next / scale;
        panY = y - (y - panY) * next / scale;
        scale = next;
        applyView();
      }
      focusDiagram = function() {
        fitDiagram();
        if (scale < 0.75 && wrapper.clientWidth) {
          zoomAt(0.75 / scale, wrapper.clientWidth / 2, wrapper.clientHeight / 2);
        }
      };

      // Render main diagram first, then overview sequentially to avoid Mermaid
      // internal ID conflicts when two renders run concurrently.
      try {
        window.mermaid.render('mermaid-svg-main', code).then(function(res) {
          canvas.innerHTML = res.svg;
          var svg = canvas.querySelector('svg');
          var viewBox = svg.viewBox.baseVal;
          diagramWidth = viewBox && viewBox.width ? viewBox.width : 800;
          diagramHeight = viewBox && viewBox.height ? viewBox.height : 600;
          svg.style.width = diagramWidth + 'px';
          svg.style.height = diagramHeight + 'px';
          svg.style.maxWidth = 'none';
          canvas.style.width = diagramWidth + 'px';
          canvas.style.height = diagramHeight + 'px';
          focusDiagram();
          // Render overview only after main is done
          return window.mermaid.render('mermaid-svg-ov', code);
        }).then(function(res) {
          if (res) {
            overviewCanvas.innerHTML = res.svg;
            _applySvgSize(overviewCanvas, 360);
          }
        }).catch(function() {
          canvas.textContent = 'This architecture diagram could not be displayed. Open Call Graph to inspect the indexed relationships.';
          overviewCanvas.textContent = 'Architecture diagram unavailable for this repository.';
        });
      } catch (err) {
        canvas.textContent = 'This architecture diagram could not be displayed. Open Call Graph to inspect the indexed relationships.';
        overviewCanvas.textContent = 'Architecture diagram unavailable for this repository.';
      }

      // Zoom at the viewport center; wheel zooms at the pointer, drag pans.
      document.getElementById('btn-zoom-in').onclick = function() {
        zoomAt(1.25, wrapper.clientWidth / 2, wrapper.clientHeight / 2);
      };
      document.getElementById('btn-zoom-out').onclick = function() {
        zoomAt(0.8, wrapper.clientWidth / 2, wrapper.clientHeight / 2);
      };
      document.getElementById('btn-zoom-reset').onclick = fitDiagram;
      wrapper.addEventListener('wheel', function(event) {
        event.preventDefault();
        var rect = wrapper.getBoundingClientRect();
        zoomAt(event.deltaY < 0 ? 1.12 : 1 / 1.12, event.clientX - rect.left, event.clientY - rect.top);
      }, {passive:false});
      var lastX, lastY;
      wrapper.addEventListener('pointerdown', function(event) {
        wrapper.setPointerCapture(event.pointerId);
        wrapper.classList.add('dragging');
        lastX = event.clientX; lastY = event.clientY;
      });
      wrapper.addEventListener('pointermove', function(event) {
        if (!wrapper.hasPointerCapture(event.pointerId)) return;
        panX += event.clientX - lastX; panY += event.clientY - lastY;
        lastX = event.clientX; lastY = event.clientY;
        applyView();
      });
      wrapper.addEventListener('pointerup', function(event) {
        if (wrapper.hasPointerCapture(event.pointerId)) wrapper.releasePointerCapture(event.pointerId);
        wrapper.classList.remove('dragging');
      });
      document.getElementById('btn-copy-mermaid').onclick = function() {
        navigator.clipboard.writeText(code);
        showToast('Mermaid syntax copied to clipboard!');
      };
      document.getElementById('btn-download-svg').onclick = function() {
        var svg = canvas.querySelector('svg');
        if (!svg) return;
        var blob = new Blob([svg.outerHTML], { type: 'image/svg+xml' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = (window.__REPO_NAME__ || 'architecture') + '-diagram.svg';
        a.click();
      };
    });
  }

  // ── CONTRIBUTORS TAB ─────────────────────────────────────────
  var _contribInited = false;
  function initContributorsTab() {
    if (_contribInited) return;
    _contribInited = true;

    var tbody = document.getElementById('contrib-tbody');
    var searchEl = document.getElementById('contrib-search');
    var emptyEl = document.getElementById('contrib-empty');
    var tableEl = document.getElementById('contrib-table');
    var totalCommits = contributors.reduce(function(sum, c) { return sum + c.commits; }, 0) || 1;
    document.getElementById('contrib-source').textContent = contributors.length
      ? 'Source: ' + (repoStats.contributor_history || 'available Git history') + ' · Up to 100 contributors' +
        (repoStats.contributor_history === 'GitHub API' ? ' · Line totals use a separately refreshed GitHub snapshot' : '')
      : repoStats.contributor_history || 'Contributor history is unavailable for this source.';
    if (!contributors.length) {
      tableEl.style.display = 'none';
      searchEl.style.display = 'none';
      emptyEl.style.display = 'block';
      emptyEl.textContent = repoStats.contributor_history === 'Local folder no contributors'
        ? 'Local folder — no contributors. Upload a ZIP that includes an initialized .git directory to show real commit history.'
        : repoStats.contributor_history === 'Git repository with no commits'
          ? 'This Git repository has no commits yet.'
          : 'No contributor commits were found.';
      return;
    }

    function renderList(list) {
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      list.slice(0, 100).forEach(function(c, idx) {
        var tr = document.createElement('tr');

        // Rank badge
        var rankTd = document.createElement('td');
        var rank = c.rank || contributors.indexOf(c) + 1;
        var medal = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : '#' + rank;
        rankTd.innerHTML = '<span class="rank-medal">' + medal + '</span>';
        tr.appendChild(rankTd);

        // Contributor with Avatar
        var authTd = document.createElement('td');
        if (c.avatar_url) {
          var avatar = document.createElement('img');
          avatar.className = 'contrib-avatar';
          avatar.src = c.avatar_url;
          avatar.alt = '';
          avatar.onerror = function() { this.style.display = 'none'; };
          authTd.appendChild(avatar);
        }

        var nameSpan = document.createElement(c.github_handle ? 'a' : 'span');
        nameSpan.textContent = c.author;
        nameSpan.style.color = '#ffffff';
        nameSpan.style.fontWeight = '600';
        nameSpan.style.textDecoration = 'none';
        if (c.github_handle) {
          nameSpan.href = 'https://github.com/' + encodeURIComponent(c.github_handle);
          nameSpan.target = '_blank';
          nameSpan.rel = 'noopener noreferrer';
        }
        authTd.appendChild(nameSpan);
        tr.appendChild(authTd);

        // Commits
        var commitTd = document.createElement('td');
        commitTd.textContent = c.commits.toLocaleString();
        commitTd.style.fontWeight = '700';
        commitTd.style.color = '#93c5fd';
        tr.appendChild(commitTd);

        // Share Progress Bar
        var shareTd = document.createElement('td');
        var pct = Math.round((c.commits / totalCommits) * 100);
        var pctLabel = pct === 0 && c.commits > 0 ? '<1%' : pct + '%';
        shareTd.innerHTML =
          '<div style="display:flex; align-items:center; gap:0.6rem;">' +
            '<div style="flex:1; height:8px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden;">' +
              '<div style="width:' + pct + '%; height:100%; background:linear-gradient(90deg, #3b82d4, #8b5cf6); border-radius:4px;"></div>' +
            '</div>' +
            '<span style="font-size:0.75rem; color:var(--text-secondary); width:36px;">' + pctLabel + '</span>' +
          '</div>';
        tr.appendChild(shareTd);

        tr.appendChild(td(c.line_stats_available === false ? '—' : '+' + (c.lines_added || 0).toLocaleString()));
        tr.appendChild(td(c.line_stats_available === false ? '—' : '-' + (c.lines_deleted || 0).toLocaleString()));

        tbody.appendChild(tr);
      });
    }

    renderList(contributors);

    searchEl.addEventListener('input', function() {
      var q = searchEl.value.toLowerCase();
      var filtered = contributors.filter(function(c) {
        return c.author.toLowerCase().includes(q) || (c.github_handle || '').toLowerCase().includes(q);
      });
      renderList(filtered);
    });
  }

  // ── CALL GRAPH TAB — Browse by source file ───────────────────
  function initCallGraphChart() {
    var symbolsByName = new Map();
    symbols.forEach(function(symbol) {
      if (!symbolsByName.has(symbol.name)) symbolsByName.set(symbol.name, []);
      symbolsByName.get(symbol.name).push(symbol);
    });
    function resolveSymbol(name) {
      var matches = symbolsByName.get(name) || symbolsByName.get(String(name).split('.').pop()) || [];
      var paths = new Set(matches.map(function(symbol) { return symbol.file; }));
      return paths.size === 1 ? matches[0] : null;
    }

    var callsByCaller = new Map();
    callEdges.forEach(function(edge) {
      if (!callsByCaller.has(edge.caller)) callsByCaller.set(edge.caller, []);
      callsByCaller.get(edge.caller).push(edge.callee);
    });
    var callers = Array.from(callsByCaller.keys());
    document.getElementById('cg-edge-count').textContent = callEdges.length.toLocaleString();
    document.getElementById('cg-caller-count').textContent = callers.length.toLocaleString();
    document.getElementById('cg-mapped-count').textContent = callers.filter(function(name) { return !!resolveSymbol(name); }).length.toLocaleString();

    var listEl = document.getElementById('cg-caller-list');
    var searchEl = document.getElementById('cg-search');
    var titleEl = document.getElementById('cg-selected-title');
    var pathEl = document.getElementById('cg-selected-path');
    var subEl = document.getElementById('cg-selected-sub');
    var sourceLink = document.getElementById('cg-inspect-file');
    var tbody = document.getElementById('cg-callee-tbody');
    var chartEl = document.getElementById('cg-freq-chart');
    var selected = '';
    var layerLabels = {
      core:'Core', api:'API', data_model:'Model', service:'Service', middleware:'Middleware',
      ui:'UI', cli:'CLI', infra:'Infrastructure', util:'Utility', test:'Test'
    };

    function renderCallees(caller) {
      selected = caller;
      var source = resolveSymbol(caller);
      var raw = callsByCaller.get(caller) || [];
      var counts = new Map();
      raw.forEach(function(name) { counts.set(name, (counts.get(name) || 0) + 1); });
      var targets = Array.from(counts, function(entry) {
        return {name:entry[0], count:entry[1], symbol:resolveSymbol(entry[0])};
      }).sort(function(a,b) { return b.count - a.count || a.name.localeCompare(b.name); });
      titleEl.textContent = caller;
      pathEl.textContent = source ? source.file + (source.line ? ':' + source.line : '') : 'Source file could not be resolved uniquely';
      subEl.textContent = targets.length + ' distinct called names · ' + raw.length + ' detected calls';
      sourceLink.style.display = source ? '' : 'none';
      if (source) sourceLink.href = window.__SUMMARY_URL__ + '?tab=symbols&file=' + encodeURIComponent(source.file);

      chartEl.textContent = '';
      if (targets.length) {
        var label = document.createElement('p');
        label.className = 'cg-panel-note';
        label.textContent = 'Most frequent called names';
        chartEl.appendChild(label);
        targets.slice(0, 5).forEach(function(target) {
          var row = document.createElement('div');
          row.style.cssText = 'display:flex;align-items:center;gap:0.6rem;margin:0.28rem 0;';
          var name = document.createElement('span');
          name.textContent = target.name;
          name.title = target.name;
          name.style.cssText = 'width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#cbd5e1;font-size:0.75rem;';
          var track = document.createElement('div');
          track.style.cssText = 'flex:1;height:8px;border-radius:8px;background:rgba(148,163,184,0.12);overflow:hidden;';
          var fill = document.createElement('div');
          fill.style.cssText = 'height:100%;border-radius:8px;background:#38bdf8;width:' + Math.round(100 * target.count / targets[0].count) + '%;';
          track.appendChild(fill);
          row.append(name, track);
          chartEl.appendChild(row);
        });
      }
      chartEl.style.display = targets.length ? 'block' : 'none';

      tbody.textContent = '';
      targets.forEach(function(target) {
        var row = document.createElement('tr');
        [target.name, target.symbol ? target.symbol.file : 'Location unresolved',
          target.symbol ? (layerLabels[target.symbol.layer] || target.symbol.layer || '—') : '—',
          String(target.count)].forEach(function(value, index) {
          var cell = document.createElement('td');
          cell.textContent = value;
          cell.title = value;
          if (index === 0) cell.style.fontWeight = '600';
          if (index === 1 && target.symbol) cell.style.color = '#93c5fd';
          if (index === 3) cell.style.textAlign = 'right';
          row.appendChild(cell);
        });
        tbody.appendChild(row);
      });
      document.querySelectorAll('.cg-caller').forEach(function(button) {
        button.classList.toggle('active', button.dataset.caller === caller);
      });
    }

    function renderCallerList() {
      var query = searchEl.value.trim().toLowerCase();
      var matching = callers.filter(function(name) {
        var source = resolveSymbol(name);
        return !query || name.toLowerCase().includes(query) || (source && source.file.toLowerCase().includes(query));
      });
      var groups = new Map();
      matching.forEach(function(name) {
        var source = resolveSymbol(name);
        var file = source ? source.file : 'Location unresolved';
        if (!groups.has(file)) groups.set(file, []);
        groups.get(file).push(name);
      });
      var ordered = Array.from(groups).sort(function(a,b) {
        if (a[0] === 'Location unresolved') return 1;
        if (b[0] === 'Location unresolved') return -1;
        function calls(group) { return group[1].reduce(function(sum,name) { return sum + callsByCaller.get(name).length; }, 0); }
        return calls(b) - calls(a) || a[0].localeCompare(b[0]);
      });
      listEl.textContent = '';
      ordered.forEach(function(group, index) {
        var file = group[0];
        var names = group[1].sort(function(a,b) {
          return callsByCaller.get(b).length - callsByCaller.get(a).length || a.localeCompare(b);
        });
        var details = document.createElement('details');
        details.className = 'cg-file-group';
        details.open = !!query || index < 3 || names.includes(selected);
        var heading = document.createElement('summary');
        heading.textContent = file;
        var count = document.createElement('span');
        count.textContent = names.length + ' callers';
        heading.appendChild(count);
        details.appendChild(heading);
        names.forEach(function(name) {
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'cg-caller' + (name === selected ? ' active' : '');
          button.dataset.caller = name;
          var label = document.createElement('span');
          label.textContent = name;
          label.title = name;
          var number = document.createElement('span');
          number.textContent = callsByCaller.get(name).length;
          button.append(label, number);
          button.addEventListener('click', function() { renderCallees(name); });
          details.appendChild(button);
        });
        listEl.appendChild(details);
      });
      if (!ordered.length) {
        var empty = document.createElement('p');
        empty.className = 'cg-empty';
        empty.textContent = query ? 'No callers match this search.' : 'No call expressions were indexed for this repository.';
        listEl.appendChild(empty);
      }
    }

    renderCallerList();
    if (callers.length) {
      var initial = callers.filter(function(name) { return !!resolveSymbol(name); }).sort(function(a,b) {
        return callsByCaller.get(b).length - callsByCaller.get(a).length;
      })[0] || callers[0];
      renderCallees(initial);
    }
    searchEl.addEventListener('input', renderCallerList);
  }

  // ── 11. SEMANTIC AUDIT TAB ────────────────────────────────────
  function initSemanticTab() {
    var emptyEl  = document.getElementById('semantic-empty');
    var tableEl  = document.getElementById('semantic-table');
    var tbody    = document.getElementById('semantic-tbody');
    var sevSel   = document.getElementById('semantic-severity');
    var catSel   = document.getElementById('semantic-category');
    var provider = document.getElementById('audit-provider');
    var endpointLabel = document.getElementById('audit-endpoint-label');
    var form = document.getElementById('audit-form');
    var status = document.getElementById('audit-status');
    provider.addEventListener('change', function() {
      endpointLabel.style.display = provider.value === 'custom' ? '' : 'none';
    });
    form.addEventListener('submit', async function(event) {
      event.preventDefault();
      var runId = window.location.pathname.match(/^\/dashboard\/(run_[a-f0-9]{12})$/);
      if (!runId) { status.textContent = 'Run a web analysis first to enable auditing.'; return; }
      var keyInput = document.getElementById('audit-key');
      var button = document.getElementById('audit-submit');
      var payload = {
        endpoint: provider.value === 'custom' ? document.getElementById('audit-endpoint').value.trim() : provider.value,
        model: document.getElementById('audit-model').value.trim(),
        api_key: keyInput.value
      };
      if (!payload.endpoint || !payload.model || !payload.api_key) {
        status.textContent = 'Enter the endpoint, model, and API key.'; return;
      }
      button.disabled = true;
      status.textContent = 'Auditing selected source files…';
      try {
        var response = await fetch('/api/audit/' + runId[1], {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        var data = await response.json();
        if (!response.ok) throw new Error(data.detail || 'Audit failed');
        window.location.reload();
      } catch (error) {
        status.textContent = error.message;
        button.disabled = false;
      } finally {
        keyInput.value = '';
        payload.api_key = '';
      }
    });

    var SEV_COLOR = { high: '#f87171', medium: '#fbbf24', low: '#86efac' };

    function renderFindings(items) {
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      items.forEach(function (f) {
        var tr = document.createElement('tr');
        var parts = f.file ? f.file.replace(/\\/g, '/').split('/') : [''];
        var fileTd = document.createElement('td');
        fileTd.textContent = parts[parts.length - 1];
        fileTd.title = f.file;
        tr.appendChild(fileTd);

        var sevTd = document.createElement('td');
        var badge = document.createElement('span');
        badge.className = 'badge';
        badge.textContent = (f.severity || '').toUpperCase();
        badge.style.color = SEV_COLOR[f.severity] || 'inherit';
        sevTd.appendChild(badge);
        tr.appendChild(sevTd);

        tr.appendChild(td(f.category || '—'));
        tr.appendChild(td(f.summary || ''));

        var detailTd = document.createElement('td');
        var details  = document.createElement('details');
        var summary  = document.createElement('summary');
        summary.textContent = 'Show detail';
        var para = document.createElement('p');
        para.style.marginTop = '0.4rem';
        para.style.color = 'var(--text-secondary)';
        para.textContent = f.detail || '';
        details.appendChild(summary);
        details.appendChild(para);
        detailTd.appendChild(details);
        tr.appendChild(detailTd);

        tbody.appendChild(tr);
      });
    }

    if (repoStats.semantic_status === 'available' && !semanticFindings.length) {
      emptyEl.textContent = 'No findings in the files reviewed by ' + (repoStats.semantic_model || 'the configured model') + '. This is not a security guarantee.';
    }
    semanticFindings.forEach(function(f) {
      if (f.category && !Array.from(catSel.options).some(function(o){ return o.value === f.category; })) {
        var option = document.createElement('option'); option.value = f.category;
        option.textContent = f.category.replace(/_/g, ' ');
        catSel.appendChild(option);
      }
    });
    if (!semanticFindings || semanticFindings.length === 0) {
      emptyEl.style.display = '';
      tableEl.style.display = 'none';
    } else {
      emptyEl.style.display = 'none';
      tableEl.style.display = '';
      renderFindings(semanticFindings);
      sevSel.addEventListener('change', function() {
        var sev = sevSel.value;
        var cat = catSel.value;
        renderFindings(semanticFindings.filter(function(f) {
          return (!sev || f.severity === sev) && (!cat || f.category === cat);
        }));
      });
      catSel.addEventListener('change', function() {
        var sev = sevSel.value;
        var cat = catSel.value;
        renderFindings(semanticFindings.filter(function(f) {
          return (!sev || f.severity === sev) && (!cat || f.category === cat);
        }));
      });
    }
  }

  showTab('overview');
}());
</script>
</div><!-- /#main-layout -->
</body>
</html>
