<!-- ============================================================
     DATA INJECTION
     The `tojson` filter HTML-escapes <, >, & inside JSON strings.
     ============================================================ -->
<script>
  window.__COMPASS_DATA__ = {{ data_json | tojson }};
  window.__REPO_NAME__    = {{ repo_name | tojson }};
  window.__SUMMARY_URL__  = {{ summary_url | tojson }};
  window.__GITHUB_SLUG__  = {{ github_slug | tojson }};
</script>

<!-- ============================================================
     INLINE SCRIPT — vanilla JS only
     ============================================================ -->
<script>
(function () {
  'use strict';

  // ── 1. Data Access & Safe JSON Parse ──────────────────────────
  var rawData = window.__COMPASS_DATA__;
  var D = typeof rawData === 'string' ? JSON.parse(rawData) : (rawData || {});
  var symbols      = D.symbols      || [];
  var callEdges    = D.call_edges   || [];
  var contributors = D.contributors || [];
  var parseErrors  = D.parse_errors || [];
  var deadCode     = new Set(D.dead_code || []);
  var semanticFindings = D.semantic_findings || [];
  var files        = D.files        || [];
  var mermaidArch  = D.architecture_mermaid || '';
  var aiPrompt     = D.ai_system_prompt || '';
  var repoStats    = D.repo_stats   || {};
  function escapeHtml(value) {
    return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ── 2. Nav, Toast & Sidebar ────────────────────────────────────
  document.getElementById('nav-repo-path').textContent = window.__REPO_NAME__ || '';

  window.showToast = function(msg) {
    var t = document.getElementById('toast-msg');
    t.textContent = msg;
    t.style.display = 'block';
    setTimeout(function() { t.style.display = 'none'; }, 2600);
  };

  window.closeModal = function(id) {
    document.getElementById(id).classList.remove('active');
  };

  // ── Sidebar Collapse Toggle ───────────────────────────────────
  (function() {
    var sidebar   = document.getElementById('sidebar');
    var layout    = document.getElementById('main-layout');
    var toggleBtn = document.getElementById('sidebar-toggle');
    var collapsed = localStorage.getItem('cc_sidebar_collapsed') === '1';

    function applySidebarState() {
      sidebar.classList.toggle('collapsed', collapsed);
      layout.classList.toggle('sidebar-collapsed', collapsed);
      toggleBtn.setAttribute('aria-expanded', String(!collapsed));
      toggleBtn.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
      toggleBtn.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
    }
    applySidebarState();

    toggleBtn.addEventListener('click', function() {
      collapsed = !collapsed;
      localStorage.setItem('cc_sidebar_collapsed', collapsed ? '1' : '0');
      applySidebarState();
    });
  }());

  if (window.location.protocol === 'file:') document.getElementById('new-analysis-link').hidden = true;

  // ── 3. Tab Router ─────────────────────────────────────────────
  var _tabInited = {};
  function showTab(id) {
    document.querySelectorAll('.tab-section').forEach(function (s) {
      s.classList.toggle('active', s.id === 'tab-' + id);
    });
    document.querySelectorAll('.sidebar-nav-btn').forEach(function (b) {
      var active = b.dataset.tab === id;
      b.classList.toggle('active', active);
      b.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    if (!_tabInited[id]) {
      _tabInited[id] = true;
      if (id === 'prompt')       initSystemPromptTab();
      if (id === 'overview')     initMermaidDiagram();
      if (id === 'architecture') requestAnimationFrame(focusDiagram);
      if (id === 'callgraph')    initCallGraphChart();
      if (id === 'contributors') initContributorsTab();
      if (id === 'semantic')     initSemanticTab();
    }
  }

  document.querySelectorAll('.sidebar-nav-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { showTab(btn.dataset.tab); });
  });

  // ── 4. Helper DOM functions ───────────────────────────────────
  function td(text) {
    var c = document.createElement('td');
    c.textContent = text == null ? '' : String(text);
    return c;
  }

  function tdBadge(text, cls) {
    var c = document.createElement('td');
    var span = document.createElement('span');
    span.className = 'badge ' + (cls || '');
    span.textContent = text == null ? '' : String(text);
    c.appendChild(span);
    return c;
  }

  function tdComplexity(n) {
    var c = document.createElement('td');
    var v = Number(n);
    c.textContent = String(v);
    if (v >= 10) c.className = 'complexity-high';
    else if (v >= 5) c.className = 'complexity-mid';
    return c;
  }

  var PAGE_SIZE = 50;
  function paginate(items, page, paginationEl, renderPageFn) {
    var total = items.length;
    var pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    page = Math.min(Math.max(page, 0), pages - 1);

    renderPageFn(items.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE));
    while (paginationEl.firstChild) paginationEl.removeChild(paginationEl.firstChild);

    var info = document.createElement('span');
    var start = total === 0 ? 0 : page * PAGE_SIZE + 1;
    var end   = Math.min((page + 1) * PAGE_SIZE, total);
    info.style.color = 'var(--text-secondary)';
    info.textContent = start + '–' + end + ' of ' + total;
    paginationEl.appendChild(info);

    var btnGroup = document.createElement('div');
    btnGroup.style.display = 'flex';
    btnGroup.style.gap = '0.5rem';

    var prevBtn = document.createElement('button');
    prevBtn.className = 'action-btn';
    prevBtn.textContent = '‹ Prev';
    prevBtn.disabled = page === 0;
    prevBtn.addEventListener('click', function () { paginate(items, page - 1, paginationEl, renderPageFn); });
    btnGroup.appendChild(prevBtn);

    var nextBtn = document.createElement('button');
    nextBtn.className = 'action-btn';
    nextBtn.textContent = 'Next ›';
    nextBtn.disabled = page === pages - 1;
    nextBtn.addEventListener('click', function () { paginate(items, page + 1, paginationEl, renderPageFn); });
    btnGroup.appendChild(nextBtn);

    paginationEl.appendChild(btnGroup);
  }

  // ── 5. OVERVIEW TAB BUILDER ───────────────────────────────────
  (function buildOverview() {
    var fileSet = new Set(symbols.map(function (s) { return s.file; }));
    var totalFiles = files.length || fileSet.size;
    var totalSymbols = symbols.length;

    var langCount = {};
    files.forEach(function (f) {
      if (!['python', 'javascript', 'typescript'].includes(f.language)) return;
      langCount[f.language] = (langCount[f.language] || 0) + 1;
    });
    var topLang = Object.keys(langCount).sort(function (a, b) {
      return langCount[b] - langCount[a];
    })[0] || 'unknown';

    var topContrib = contributors.length
      ? contributors.slice().sort(function (a, b) { return b.commits - a.commits; })[0].author
      : 'Unavailable';

    var cards = [
      { label: 'Files Indexed',   value: totalFiles,          sub: 'eligible repository files' },
      { label: 'Symbols Found',   value: totalSymbols,        sub: 'functions & classes' },
      { label: 'Call Edges',      value: callEdges.length,    sub: 'detected call expressions' },
      { label: 'Contributors',    value: contributors.length, sub: repoStats.contributor_history || 'Git history unavailable' },
      { label: 'Top Language',    value: topLang.toUpperCase(),sub: 'dominant ecosystem' },
      { label: 'Top Contributor', value: topContrib,          sub: 'most active committer' },
    ];

    var container = document.getElementById('overview-cards');
    cards.forEach(function (c) {
      var card  = document.createElement('div');  card.className = 'stat-card';
      var label = document.createElement('div');  label.className = 'stat-label';
      var value = document.createElement('div');  value.className = 'stat-value';
      var sub   = document.createElement('div');  sub.className = 'stat-sub';
      label.textContent = c.label;
      value.textContent = String(c.value);
      sub.textContent   = c.sub;
      card.appendChild(label);
      card.appendChild(value);
      card.appendChild(sub);
      container.appendChild(card);
    });

    // Health Scorecard
    var hScore = repoStats.health_score ?? '—';
    document.getElementById('health-inner').textContent = String(hScore);
    document.getElementById('overview-dead-ratio').textContent = (repoStats.dead_code_ratio || 0.0) + '%';
    document.getElementById('overview-avg-complexity').textContent = 'Avg ' + (repoStats.average_complexity ?? '—');
    document.getElementById('health-tier').textContent = typeof hScore === 'number'
      ? (hScore >= 85 ? 'Lower complexity' : 'Higher complexity') : 'No symbols analyzed';

    // Architecture Matrix: layer breakdown
    var layerLabels = {
      core:'Core / Engine', api:'API / Routes', data_model:'Models & Schemas',
      service:'Services & Logic', middleware:'Middleware & Auth', ui:'UI & Presentation',
      cli:'CLI & Commands', infra:'Infra & Config', util:'Utilities', test:'Tests'
    };
    var layerFileCount = {}, layerSymCount = {}, layerCxSum = {}, layerCxN = {};
    files.forEach(function(f) {
      var l = f.layer || 'core';
      layerFileCount[l] = (layerFileCount[l] || 0) + 1;
    });
    symbols.forEach(function(s) {
      var l = s.layer || 'core';
      layerSymCount[l] = (layerSymCount[l] || 0) + 1;
      layerCxSum[l]  = (layerCxSum[l]  || 0) + (s.complexity || 1);
      layerCxN[l]    = (layerCxN[l]    || 0) + 1;
    });
    var matrixTbody = document.getElementById('arch-matrix-tbody');
    if (matrixTbody) {
      Object.keys(layerLabels).forEach(function(k) {
        if (!layerFileCount[k]) return;
        var tr = document.createElement('tr');
        var avgCx = layerCxN[k] ? (layerCxSum[k] / layerCxN[k]).toFixed(1) : '–';
        tr.innerHTML =
          '<td style="padding:0.35rem 0.6rem; color:#e2e8f0;">' + (layerLabels[k] || k) + '</td>' +
          '<td style="padding:0.35rem 0.6rem; text-align:right; color:#93c5fd;">' + (layerFileCount[k] || 0) + '</td>' +
          '<td style="padding:0.35rem 0.6rem; text-align:right; color:#c4b5fd;">' + (layerSymCount[k] || 0) + '</td>' +
          '<td style="padding:0.35rem 0.6rem; text-align:right;">' + avgCx + '</td>';
        matrixTbody.appendChild(tr);
      });
    }
    var metaEl = document.getElementById('arch-matrix-meta');
    if (metaEl) {
      metaEl.innerHTML =
        '<span>Dominant ecosystem: <strong style="color:#93c5fd;">' + topLang.toUpperCase() + '</strong></span>' +
        '<span>Symbol density: <strong style="color:#c4b5fd;">' + (totalFiles ? (totalSymbols / totalFiles).toFixed(1) : '0') + ' sym/file</strong></span>' +
        '<span>Total layers: <strong style="color:#6ee7b7;">' + Object.keys(layerFileCount).length + '</strong></span>';
    }
  }());

  // ── HERO: Wire metric cards & canvas topology ─────────────────
  (function initHero() {
    // Wire Files count
    var filesEl = document.getElementById('hero-files-count');
    if (filesEl) {
      var totalFiles = files.length || (new Set(symbols.map(function(s){ return s.file; }))).size;
      filesEl.textContent = totalFiles.toLocaleString();
    }
    document.getElementById('hero-analysis-time').textContent = repoStats.analysis_seconds == null
      ? '—' : repoStats.analysis_seconds + 's';
    // Panic count = semantic findings with severity 'high'
    var panicEl = document.getElementById('hero-panic-count');
    if (panicEl) {
      var panics = (D.semantic_findings || []).filter(function(f){ return f.severity === 'high'; });
      panicEl.textContent = repoStats.semantic_status === 'available' ? panics.length : '—';
      document.getElementById('hero-panic-label').textContent = repoStats.semantic_status === 'available'
        ? 'High-severity audit findings' : 'Semantic audit unavailable';
    }

    // Canvas topology
    var canvas = document.getElementById('hero-topology-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var rankedFiles = files.slice().sort(function(a,b){ return (b.rank_score || 0) - (a.rank_score || 0); }).slice(0, 8);
    var hubs = rankedFiles.map(function(file, i) {
      var angle = (2 * Math.PI * i / Math.max(rankedFiles.length, 1)) - Math.PI / 2;
      return {
        path: file.path, label: file.path.split(/[\\/]/).pop(),
        x: 0.5 + 0.34 * Math.cos(angle), y: 0.5 + 0.30 * Math.sin(angle),
        r: i === 0 ? 9 : 6, color: i === 0 ? '#fbbf24' : '#38bdf8',
        glow: i === 0 ? 'rgba(251,191,36,0.5)' : 'rgba(56,189,248,0.45)'
      };
    });
    var symbolFile = {};
    symbols.forEach(function(s) { if (s.name && s.file) symbolFile[s.name] = s.file; });
    var hubIndex = {};
    hubs.forEach(function(h, i) { hubIndex[h.path] = i; });
    var edgeSeen = {};
    var edges = [];
    callEdges.forEach(function(e) {
      var from = hubIndex[symbolFile[e.caller] || symbolFile[(e.caller || '').split('.').pop()]];
      var to = hubIndex[symbolFile[e.callee] || symbolFile[(e.callee || '').split('.').pop()]];
      var key = from + ':' + to;
      if (from != null && to != null && from !== to && !edgeSeen[key]) {
        edges.push([from, to]); edgeSeen[key] = true;
      }
    });
    var floatPhase = 0;

    function resizeCanvas() {
      var rect = canvas.parentElement.getBoundingClientRect();
      canvas.width  = rect.width  || 400;
      canvas.height = rect.height || 220;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    function drawFrame() {
      var W = canvas.width, H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      // Subtle deep background glow layers
      var bg1 = ctx.createRadialGradient(W*0.3, H*0.4, 0, W*0.3, H*0.4, W*0.5);
      bg1.addColorStop(0, 'rgba(0,100,180,0.08)');
      bg1.addColorStop(1, 'transparent');
      ctx.fillStyle = bg1; ctx.fillRect(0,0,W,H);
      var bg2 = ctx.createRadialGradient(W*0.75, H*0.6, 0, W*0.75, H*0.6, W*0.4);
      bg2.addColorStop(0, 'rgba(0,180,216,0.06)');
      bg2.addColorStop(1, 'transparent');
      ctx.fillStyle = bg2; ctx.fillRect(0,0,W,H);

      // Compute positions with float offset
      var positions = hubs.map(function(h, i) {
        var offset = Math.sin(floatPhase + i * 1.1) * 4;
        return { x: h.x * W, y: h.y * H + offset };
      });

      // Draw edges
      edges.forEach(function(e) {
        var a = positions[e[0]], b = positions[e[1]];
        var grad = ctx.createLinearGradient(a.x, a.y, b.x, b.y);
        grad.addColorStop(0, 'rgba(0,180,216,0.35)');
        grad.addColorStop(1, 'rgba(56,189,248,0.20)');
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.2;
        ctx.stroke();
      });

      // Draw nodes
      hubs.forEach(function(h, i) {
        var p = positions[i];
        var pulse = 1 + 0.08 * Math.sin(floatPhase * 1.5 + i * 0.8);
        var r = h.r * pulse;

        // Glow
        var glowGrad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r * 3.5);
        glowGrad.addColorStop(0, h.glow);
        glowGrad.addColorStop(1, 'transparent');
        ctx.beginPath();
        ctx.arc(p.x, p.y, r * 3.5, 0, Math.PI * 2);
        ctx.fillStyle = glowGrad; ctx.fill();

        // Node circle
        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx.fillStyle = h.color;
        ctx.fill();

        // Label
        ctx.font = '600 ' + (r > 8 ? '11' : '9') + 'px system-ui,sans-serif';
        ctx.fillStyle = 'rgba(255,255,255,0.85)';
        ctx.textAlign = 'center';
        ctx.fillText(h.label, p.x, p.y + r + 13);
      });

      floatPhase += 0.018;
      requestAnimationFrame(drawFrame);
    }
    drawFrame();
  }());

