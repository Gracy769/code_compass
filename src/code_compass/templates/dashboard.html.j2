<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Code Compass — {{ repo_name }}</title>
  <!-- Chart.js loaded from CDN (primary chart library) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    /* ============================================================
       CODE COMPASS — ADVANCED GLASS/CLAY ARCHITECTURE DESIGN SYSTEM
       ============================================================ */

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --glass-bg:       rgba(255, 255, 255, 0.05);
      --glass-bg-nav:   rgba(13, 17, 23, 0.85);
      --glass-border:   rgba(255, 255, 255, 0.12);
      --blur-radius:    16px;

      --clay-shadow:
        0 1px 0 0 rgba(255,255,255,0.18) inset,
        0 -1px 0 0 rgba(0,0,0,0.30) inset,
        0 8px 24px -4px rgba(0,0,0,0.55),
        0 2px 6px -1px rgba(0,0,0,0.40);
      --clay-highlight:
        0 1px 0 0 rgba(255,255,255,0.22) inset,
        0 -1px 0 0 rgba(0,0,0,0.35) inset,
        0 12px 32px -4px rgba(59,130,212,0.30),
        0 4px 10px -2px rgba(0,0,0,0.50);
      --clay-press:
        0 1px 0 0 rgba(255,255,255,0.10) inset,
        0 2px 0 0 rgba(0,0,0,0.40) inset,
        0 2px 6px -1px rgba(0,0,0,0.50);

      --accent:         #3b82d4;
      --accent-hover:   #60a5fa;
      --accent-muted:   rgba(59, 130, 212, 0.25);
      --text-primary:   #e2e8f0;
      --text-secondary: #94a3b8;
      --surface:        rgba(255, 255, 255, 0.04);
      --danger:         #f87171;
      --warn:           #fbbf24;
      --success:        #86efac;
      --purple:         #c084fc;

      --radius-card:    1.25rem;
      --radius-btn:     1.2rem;
      --radius-sm:      0.5rem;
    }

    body {
      background-color: #0b0f19;
      background-image:
        radial-gradient(ellipse 90% 60% at 50% -10%, rgba(59, 130, 212, 0.16), transparent),
        radial-gradient(ellipse 50% 40% at 90%  90%, rgba(139,  92, 246, 0.08), transparent),
        linear-gradient(180deg, #0b0f19 0%, #080c14 100%);
      background-attachment: fixed;
      color: var(--text-primary);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
    }

    /* ── Nav Bar ────────────────────────────────────────────────── */
    .nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1.75rem;
      background: var(--glass-bg-nav);
      border-bottom: 1px solid var(--glass-border);
      backdrop-filter: blur(var(--blur-radius));
      -webkit-backdrop-filter: blur(var(--blur-radius));
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nav-left { display: flex; align-items: center; gap: 0.75rem; }
    .nav-bar .app-logo {
      width: 28px; height: 28px;
      display: inline-flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #3b82d4, #8b5cf6);
      border-radius: 8px; box-shadow: 0 2px 8px rgba(59,130,212,0.4);
    }
    .nav-bar .app-name {
      font-weight: 700;
      font-size: 1.15rem;
      color: #ffffff;
      letter-spacing: -0.01em;
    }
    .nav-bar .repo-badge {
      font-size: 0.8rem;
      padding: 0.2rem 0.65rem;
      border-radius: 20px;
      background: rgba(59, 130, 212, 0.15);
      border: 1px solid rgba(59, 130, 212, 0.3);
      color: #93c5fd;
      font-weight: 500;
      max-width: 320px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .nav-actions { display: flex; align-items: center; gap: 0.6rem; }
    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.95rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.06);
      color: var(--text-primary);
      transition: all 0.18s ease;
      box-shadow: var(--clay-shadow);
    }
    .action-btn:hover {
      background: rgba(255,255,255,0.12);
      border-color: rgba(255,255,255,0.25);
      transform: translateY(-1px);
    }
    .action-btn-primary {
      background: linear-gradient(135deg, #2563eb, #3b82d4);
      border-color: rgba(96,165,250,0.4);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(37,99,235,0.35);
    }
    .action-btn-primary:hover {
      background: linear-gradient(135deg, #1d4ed8, #2563eb);
      box-shadow: 0 6px 18px rgba(37,99,235,0.45);
    }

    /* ── Tab Strip ──────────────────────────────────────────────── */
    .tab-strip {
      display: flex;
      gap: 0.5rem;
      padding: 0.75rem 1.75rem 0;
      border-bottom: 1px solid var(--glass-border);
      background: rgba(13, 17, 23, 0.65);
      backdrop-filter: blur(8px);
      overflow-x: auto;
    }
    .tab-btn {
      padding: 0.55rem 1.25rem;
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: var(--radius-btn) var(--radius-btn) 0 0;
      border-bottom: none;
      background: rgba(255,255,255,0.04);
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: var(--clay-shadow);
      transition: all 0.18s ease;
    }
    .tab-btn:hover {
      background: rgba(59,130,212,0.12);
      color: var(--text-primary);
      transform: translateY(-2px);
    }
    .tab-btn.active {
      background: linear-gradient(180deg, rgba(59,130,212,0.22) 0%, rgba(59,130,212,0.08) 100%);
      color: var(--accent);
      font-weight: 600;
      border-color: rgba(59,130,212,0.4);
      box-shadow: 0 8px 20px -4px rgba(59,130,212,0.35);
    }

    /* ── Content Area ───────────────────────────────────────────── */
    .tab-content { padding: 1.75rem; max-width: 1600px; margin: 0 auto; }
    .tab-section { display: none; }
    .tab-section.active { display: block; animation: fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    /* ── Bento Grid & Section Cards ─────────────────────────────── */
    .section-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-card);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(var(--blur-radius));
      box-shadow: var(--clay-shadow);
      overflow-x: auto;
    }
    .data-table {
      table-layout: fixed;
      width: 100%;
    }
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1.25rem;
      margin-bottom: 1.75rem;
    }
    .bento-col-4  { grid-column: span 4; }
    .bento-col-6  { grid-column: span 6; }
    .bento-col-8  { grid-column: span 8; }
    .bento-col-12 { grid-column: span 12; }
    @media (max-width: 1024px) {
      .bento-col-4, .bento-col-6, .bento-col-8 { grid-column: span 12; }
    }

    /* Stat Cards */
    .stat-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 1.1rem;
      margin-bottom: 1.75rem;
    }
    .stat-card {
      background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 1rem;
      padding: 1.2rem 1.4rem;
      box-shadow: var(--clay-shadow);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--clay-highlight);
    }
    .stat-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      margin-bottom: 0.35rem;
    }
    .stat-value {
      font-size: 1.95rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.15;
    }
    .stat-sub {
      font-size: 0.75rem;
      color: var(--text-secondary);
      margin-top: 0.35rem;
    }

    /* Health Gauge */
    .health-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 76px; height: 76px;
      border-radius: 50%;
      background: conic-gradient(#10b981 0% 92%, #374151 92% 100%);
      position: relative;
    }
    .health-inner {
      width: 60px; height: 60px;
      border-radius: 50%;
      background: #0f172a;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-size: 1.25rem; font-weight: 800; color: #10b981;
    }

    /* Tag Cloud */
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.6rem; }
    .tag-pill {
      font-size: 0.72rem;
      padding: 0.2rem 0.55rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .tag-pill:hover, .tag-pill.active {
      background: rgba(59, 130, 212, 0.22);
      border-color: rgba(59, 130, 212, 0.45);
      color: #93c5fd;
    }

    /* Tables & Toolbars */
    .table-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 1.25rem;
    }
    .table-toolbar input[type="text"], .table-toolbar select {
      padding: 0.45rem 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.35);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 0.85rem;
      outline: none;
    }
    .table-toolbar input[type="text"]:focus, .table-toolbar select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(59, 130, 212, 0.25);
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
    }
    .data-table th, .data-table td {
      padding: 0.65rem 0.95rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .data-table th {
      color: var(--text-secondary);
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }
    .data-table th:hover { color: var(--text-primary); }
    .data-table tr:hover td { background: rgba(255, 255, 255, 0.02); }

    /* Badges */
    .badge {
      display: inline-block;
      padding: 0.18rem 0.55rem;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .badge-core   { background: rgba(59, 130, 212, 0.2); color: #93c5fd; border: 1px solid rgba(59, 130, 212, 0.35); }
    .badge-api    { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.35); }
    .badge-model  { background: rgba(139, 92, 246, 0.2); color: #c4b5fd; border: 1px solid rgba(139, 92, 246, 0.35); }
    .badge-service{ background: rgba(245, 158, 11, 0.2); color: #fcd34d; border: 1px solid rgba(245, 158, 11, 0.35); }
    .badge-ui     { background: rgba(236, 72, 153, 0.2); color: #f472b6; border: 1px solid rgba(236, 72, 153, 0.35); }
    .badge-tier1  { background: linear-gradient(135deg, rgba(37,99,235,0.4), rgba(59,130,212,0.2)); color: #bfdbfe; font-weight: 700; border: 1px solid rgba(96,165,250,0.5); }
    .badge-tier2  { background: rgba(245, 158, 11, 0.15); color: #fde68a; border: 1px solid rgba(245, 158, 11, 0.3); }

    /* Complexity color */
    .complexity-high { color: var(--danger); font-weight: 600; }
    .complexity-mid  { color: var(--warn); font-weight: 500; }

    /* Contributor items */
    .contrib-avatar {
      width: 32px; height: 32px;
      border-radius: 50%;
      vertical-align: middle;
      margin-right: 0.6rem;
      border: 1px solid rgba(255,255,255,0.15);
      background: #1e293b;
    }
    .rank-medal { font-size: 1.1rem; margin-right: 0.3rem; }

    /* Mermaid Architecture Container */
    .mermaid-container {
      position: relative;
      background: #0d1117;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.5rem;
      overflow: hidden;
      min-height: 480px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .diagram-toolbar {
      position: absolute;
      top: 1rem; right: 1rem;
      display: flex; gap: 0.5rem;
      z-index: 10;
      background: rgba(13, 17, 23, 0.85);
      padding: 0.4rem;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.1);
      backdrop-filter: blur(8px);
    }
    .diagram-btn {
      padding: 0.35rem 0.65rem;
      font-size: 0.78rem;
      font-weight: 600;
      border-radius: 6px;
      background: rgba(255,255,255,0.06);
      color: var(--text-primary);
      border: 1px solid rgba(255,255,255,0.12);
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 0.3rem;
      transition: all 0.15s ease;
    }
    .diagram-btn:hover { background: rgba(59,130,212,0.25); border-color: var(--accent); }

    /* Modal Overlay */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      z-index: 999;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-overlay.active { display: flex; }
    .modal-card {
      background: #0f172a;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      max-width: 640px;
      width: 100%;
      padding: 1.75rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      position: relative;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .modal-title { font-size: 1.25rem; font-weight: 700; color: #ffffff; }
    .modal-close { background: none; border: none; font-size: 1.4rem; color: var(--text-secondary); cursor: pointer; }
    .modal-close:hover { color: #ffffff; }

    /* Toast */
    #toast-msg {
      position: fixed;
      bottom: 2rem; right: 2rem;
      background: #1e293b;
      border: 1px solid #3b82d4;
      color: #ffffff;
      padding: 0.65rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      font-size: 0.85rem;
      z-index: 10000;
      display: none;
      animation: fadeIn 0.2s ease;
    }
  </style>
</head>
<body>

<!-- ── Navigation Bar ───────────────────────────────────────────── -->
<header class="nav-bar">
  <div class="nav-left">
    <div class="app-logo">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
      </svg>
    </div>
    <span class="app-name">Code Compass</span>
    <span class="repo-badge" id="nav-repo-path">{{ repo_name }}</span>
  </div>

  <div class="nav-actions">
    <!-- Single dynamic GitHub button: Sign in → Upload from GitHub -->
    <button class="action-btn" id="btn-gh-dynamic" title="Sign in with GitHub or upload from GitHub">
      <!-- Icon and label are set by JS based on auth state -->
      <svg id="gh-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span id="gh-btn-label">Sign in</span>
    </button>
    <button class="action-btn" id="btn-upload-local" title="Upload from local folder">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
      </svg>
      Local Folder
    </button>
    <input type="file" id="local-folder-picker" webkitdirectory directory multiple style="display:none" />
  </div>
</header>

<!-- ── Tab Navigation Strip ────────────────────────────────────── -->
<div class="tab-strip" role="tablist">
  <button class="tab-btn active" role="tab" aria-selected="true"  aria-controls="tab-overview"     data-tab="overview">Overview</button>
  <button class="tab-btn"        role="tab" aria-selected="false" aria-controls="tab-prompt"       data-tab="prompt">System Prompt</button>
  <button class="tab-btn"        role="tab" aria-selected="false" aria-controls="tab-architecture" data-tab="architecture">Architecture (Mermaid)</button>
  <button class="tab-btn"        role="tab" aria-selected="false" aria-controls="tab-callgraph"    data-tab="callgraph">Call Graph</button>
  <button class="tab-btn"        role="tab" aria-selected="false" aria-controls="tab-contributors" data-tab="contributors">Contributors (Top 100)</button>
  <button class="tab-btn"        role="tab" aria-selected="false" aria-controls="tab-semantic"     data-tab="semantic">Semantic Audit</button>
</div>

<!-- ── Content Container ───────────────────────────────────────── -->
<div class="tab-content">

  <!-- ── 1. OVERVIEW TAB (Requirement 5: Bento Grid + Detailed AI Prompt) ── -->
  <section id="tab-overview" class="tab-section active" role="tabpanel">
    <!-- Top Summary Stat Cards -->
    <div class="stat-cards" id="overview-cards"></div>

    <div class="bento-grid">
      <!-- Health & Architecture Scorecard -->
      <div class="section-card bento-col-4">
        <h3 style="margin-bottom: 1rem; display:flex; align-items:center; gap:0.5rem; color:#fff;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          Repo Health Scorecard
        </h3>
        <div style="display:flex; align-items:center; gap:1.25rem; margin-bottom:1.25rem;">
          <div class="health-badge" id="health-gauge">
            <div class="health-inner" id="health-inner">96</div>
          </div>
          <div>
            <div style="font-weight:700; font-size:1.05rem; color:#ffffff;" id="health-tier">Excellent Health</div>
            <div style="font-size:0.8rem; color:var(--text-secondary);">Automated AST structural & safety audit score</div>
          </div>
        </div>
        <div style="display:flex; flex-direction:column; gap:0.55rem; font-size:0.82rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Modularity Index</span>
            <span style="color:#86efac; font-weight:600;">High (0.84)</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Cyclomatic Complexity</span>
            <span style="color:#93c5fd; font-weight:600;">Low Risk (Avg 2.4)</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Dead Code Ratio</span>
            <span style="color:#fbbf24; font-weight:600;" id="overview-dead-ratio">0.0%</span>
          </div>
        </div>
      </div>

      <!-- Repository Architecture Matrix & Summary -->
      <div class="section-card bento-col-8" style="overflow-x:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
          <h3 style="display:flex; align-items:center; gap:0.5rem; color:#fff;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82d4" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            Repository Architecture Matrix
          </h3>
          <button class="action-btn action-btn-primary" id="btn-open-summary" onclick="window.open(window.__SUMMARY_URL__,'_blank');">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Open Summary &rarr;
          </button>
        </div>
        <table style="width:100%; border-collapse:collapse; font-size:0.83rem; table-layout:fixed;">
          <thead>
            <tr>
